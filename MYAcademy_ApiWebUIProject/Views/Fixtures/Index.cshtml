@model List<MYAcademy_ApiWebUIProject.Controllers.MatchDto>
@using System.Linq
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "Serie A | Futbol Merkezi";

    var matches = Model ?? new List<MYAcademy_ApiWebUIProject.Controllers.MatchDto>();
    var selectedWeek = matches.FirstOrDefault()?.Week ?? 1;

    if (int.TryParse(Context.Request.Query["week"], out var requestedWeek))
        selectedWeek = Math.Clamp(requestedWeek, 1, 38);

    var completed = matches
        .Where(m => m.HomeScore.HasValue && m.AwayScore.HasValue)
        .ToList();

    var pending = matches.Count - completed.Count;
    var totalGoals = completed.Sum(m =>
        m.HomeScore.GetValueOrDefault() + m.AwayScore.GetValueOrDefault());

    var homeWins = completed.Count(m => m.HomeScore > m.AwayScore);
    var draws = completed.Count(m => m.HomeScore == m.AwayScore);
    var awayWins = completed.Count(m => m.AwayScore > m.HomeScore);

    var homeGoals = completed.Sum(m => m.HomeScore.GetValueOrDefault());
    var awayGoals = completed.Sum(m => m.AwayScore.GetValueOrDefault());

    var averageGoals = completed.Count == 0
        ? 0
        : totalGoals / (double)completed.Count;

    var teams = matches
        .SelectMany(m => new[] { m.HomeTeam?.Name, m.AwayTeam?.Name })
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    var teamStats = teams.Select(team => new
    {
        Name = team!,
        Goals = completed.Sum(m =>
            (string.Equals(m.HomeTeam?.Name, team, StringComparison.OrdinalIgnoreCase)
                ? m.HomeScore.GetValueOrDefault() : 0)
            +
            (string.Equals(m.AwayTeam?.Name, team, StringComparison.OrdinalIgnoreCase)
                ? m.AwayScore.GetValueOrDefault() : 0))
    })
    .OrderByDescending(x => x.Goals)
    .ThenBy(x => x.Name)
    .ToList();

    var chartTeams = teamStats.Take(10).ToList();
    var teamLabels = chartTeams.Select(x => x.Name).ToArray();
    var teamGoals = chartTeams.Select(x => x.Goals).ToArray();

    var outcomeLabels = new[]
    {
        "Ev sahibi galibiyeti",
        "Beraberlik",
        "Deplasman galibiyeti"
    };

    var outcomeValues = new[] { homeWins, draws, awayWins };

    var matchIds = completed
        .Select(m => m.MatchId)
        .Distinct()
        .ToArray();
}

