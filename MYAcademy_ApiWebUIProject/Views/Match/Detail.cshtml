@model SerieA.WebUI.ViewModels.MatchDetailViewModel
@using System.Linq
@using System.Globalization

@{
    ViewData["Title"] = $"{Model.HomeTeam} - {Model.AwayTeam} | Maç Analizi";

    var goals = Model.Goals ?? new List<SerieA.WebUI.ViewModels.MatchGoalViewModel>();
    var cards = Model.Cards ?? new List<SerieA.WebUI.ViewModels.MatchCardViewModel>();
    var substitutions = Model.Substitutions ?? new List<SerieA.WebUI.ViewModels.MatchSubstitutionViewModel>();

    var home = Model.HomeTeam ?? "Ev Sahibi";
    var away = Model.AwayTeam ?? "Deplasman";
    var status = Model.Status ?? "";
    var hasScore = Model.HomeScore.HasValue && Model.AwayScore.HasValue;

    var finished = status.Contains("Tamamlandı", StringComparison.OrdinalIgnoreCase)
        || status.Contains("Bitti", StringComparison.OrdinalIgnoreCase);

    var homeGoals = goals.Count(x => string.Equals(x.Team, home, StringComparison.OrdinalIgnoreCase));
    var awayGoals = goals.Count(x => string.Equals(x.Team, away, StringComparison.OrdinalIgnoreCase));

    var homeYellow = cards.Count(x => string.Equals(x.Team, home, StringComparison.OrdinalIgnoreCase)
        && (x.CardType ?? "").Contains("Sarı", StringComparison.OrdinalIgnoreCase));
    var awayYellow = cards.Count(x => string.Equals(x.Team, away, StringComparison.OrdinalIgnoreCase)
        && (x.CardType ?? "").Contains("Sarı", StringComparison.OrdinalIgnoreCase));

    var homeRed = cards.Count(x => string.Equals(x.Team, home, StringComparison.OrdinalIgnoreCase)
        && (x.CardType ?? "").Contains("Kırmızı", StringComparison.OrdinalIgnoreCase));
    var awayRed = cards.Count(x => string.Equals(x.Team, away, StringComparison.OrdinalIgnoreCase)
        && (x.CardType ?? "").Contains("Kırmızı", StringComparison.OrdinalIgnoreCase));

    var totalGoals = hasScore ? Model.HomeScore.GetValueOrDefault() + Model.AwayScore.GetValueOrDefault() : goals.Count;
    var totalCards = cards.Count;
    var totalSubs = substitutions.Count;

    var homeInitial = string.IsNullOrWhiteSpace(home) ? "H" : home.Substring(0, 1).ToUpperInvariant();
    var awayInitial = string.IsNullOrWhiteSpace(away) ? "D" : away.Substring(0, 1).ToUpperInvariant();

    var events = new List<(int Minute, string Type, string Player, string Detail, string Team)>();

    foreach (var goal in goals)
        events.Add((goal.Minute, "goal", goal.PlayerName ?? "Bilinmeyen oyuncu", "Gol", goal.Team ?? ""));

    foreach (var card in cards)
        events.Add((card.Minute, "card", card.PlayerName ?? "Bilinmeyen oyuncu", card.CardType ?? "Kart", card.Team ?? ""));

    foreach (var sub in substitutions)
        events.Add((sub.Minute, "sub", sub.PlayerIn ?? "Bilinmeyen oyuncu",
            "Oyundan çıkan: " + (sub.PlayerOut ?? "-"), sub.Team ?? ""));

    events = events.OrderBy(x => x.Minute).ToList();

    var goalBuckets = new int[6];
    foreach (var goal in goals)
    {
        var bucket = Math.Min(5, Math.Max(0, goal.Minute / 15));
        goalBuckets[bucket]++;
    }

    var goalBucketLabels = new[] { "0–14", "15–29", "30–44", "45–59", "60–74", "75+" };
    var goalBucketMax = Math.Max(1, goalBuckets.DefaultIfEmpty(0).Max());

    var homeGoalPercent = totalGoals == 0 ? 0 : (int)Math.Round(homeGoals * 100.0 / Math.Max(1, homeGoals + awayGoals));
    var awayGoalPercent = totalGoals == 0 ? 0 : 100 - homeGoalPercent;

    var totalYellows = homeYellow + awayYellow;
    var totalReds = homeRed + awayRed;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --ma-bg: #07101f;
        --ma-panel: #0e1b32;
        --ma-panel2: #132442;
        --ma-line: #233757;
        --ma-text: #edf3ff;
        --ma-muted: #91a5c8;
        --ma-blue: #4d8dff;
        --ma-cyan: #42d6e8;
        --ma-green: #36d6a0;
        --ma-yellow: #f4c451;
        --ma-red: #ff6177;
        --ma-purple: #a98bff;
    }

    body {
        background: var(--ma-bg) !important;
        color: var(--ma-text);
        font-family: "Barlow", sans-serif;
    }

    .ma-page {
        min-height: 100vh;
        padding: 28px 0 60px;
        background: radial-gradient(900px 440px at 0% 0%, rgba(77,141,255,.17), transparent 65%), radial-gradient(800px 400px at 100% 15%, rgba(66,214,232,.07), transparent 65%), var(--ma-bg);
    }

    .ma-shell {
        width: min(1240px, calc(100% - 36px));
        margin: auto;
    }

    .ma-back {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: #adc4e8;
        font-weight: 600;
        text-decoration: none;
    }

        .ma-back:hover {
            color: white;
        }

    .ma-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: 30px;
        border: 1px solid #2a4267;
        border-radius: 23px;
        background: linear-gradient(135deg, #152e56, #0e1c36 65%, #0b172c);
        box-shadow: 0 24px 65px rgba(0,0,0,.2);
    }

        .ma-hero::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: 0;
            background: repeating-linear-gradient(90deg, transparent 0 75px, rgba(255,255,255,.018) 75px 76px);
            pointer-events: none;
        }

        .ma-hero::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 65%;
            height: 3px;
            background: linear-gradient(90deg, var(--ma-blue), var(--ma-cyan), transparent);
        }

    .ma-hero-top, .ma-league, .ma-status, .ma-meta, .ma-section-head,
    .ma-footer, .ma-team, .ma-filter-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ma-league {
        justify-content: flex-start;
        color: #c4d6f5;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .ma-mark {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: linear-gradient(135deg, var(--ma-cyan), var(--ma-blue));
        color: #07101f;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 1.4rem;
        font-weight: 800;
    }

    .ma-status {
        justify-content: flex-start;
        width: fit-content;
        padding: 8px 12px;
        border: 1px solid rgba(145,165,200,.24);
        border-radius: 999px;
        background: rgba(255,255,255,.04);
        color: #c9d8ef;
        font-size: .75rem;
        font-weight: 700;
    }

        .ma-status.done {
            color: #7debc2;
            border-color: rgba(54,214,160,.3);
        }

            .ma-status.done::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--ma-green);
            }

    .ma-season {
        color: #8fa9d1;
        font-size: .82rem;
    }

    .ma-matchup {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
        align-items: center;
        gap: 22px;
        margin-top: 32px;
    }

    .ma-team {
        justify-content: flex-start;
        min-width: 0;
        gap: 16px;
    }

        .ma-team.away {
            flex-direction: row-reverse;
            text-align: right;
        }

    .ma-crest {
        display: grid;
        place-items: center;
        flex: 0 0 76px;
        width: 76px;
        height: 76px;
        border: 1px solid rgba(173,196,232,.28);
        border-radius: 50%;
        background: linear-gradient(145deg, #244b85, #0b1b34);
        box-shadow: inset 0 0 22px rgba(77,141,255,.16), 0 12px 24px rgba(0,0,0,.18);
        color: white;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 2rem;
        font-weight: 800;
    }

    .ma-team.away .ma-crest {
        background: linear-gradient(145deg, #384766, #101b31);
    }

    .ma-team-label {
        display: block;
        margin-bottom: 8px;
        color: #8fa9d1;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .12em;
    }

    .ma-team-name {
        margin: 0;
        color: white;
        font-family: "Barlow Condensed", sans-serif;
        font-size: clamp(1.5rem, 3vw, 2.7rem);
        font-weight: 800;
        line-height: 1;
        overflow-wrap: anywhere;
    }

    .ma-scoreboard {
        text-align: center;
    }

    .ma-score {
        color: white;
        font-family: "Barlow Condensed", sans-serif;
        font-size: clamp(3.2rem, 7vw, 5.5rem);
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
    }

        .ma-score span {
            color: var(--ma-cyan);
            padding: 0 5px;
        }

    .ma-vs {
        color: #c5d6f3;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 2rem;
        font-weight: 800;
    }

    .ma-time {
        margin-top: 9px;
        color: #91a9cf;
        font-size: .85rem;
    }

    .ma-meta {
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 27px;
        padding-top: 18px;
        border-top: 1px solid rgba(145,165,200,.16);
        color: #a9bfdf;
        font-size: .84rem;
    }

    .ma-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 13px;
        margin-top: 18px;
    }

    .ma-kpi {
        position: relative;
        overflow: hidden;
        padding: 19px;
        border: 1px solid var(--ma-line);
        border-radius: 16px;
        background: linear-gradient(145deg, var(--ma-panel), #0b172b);
    }

        .ma-kpi::after {
            content: "";
            position: absolute;
            right: -18px;
            bottom: -30px;
            width: 85px;
            height: 85px;
            border-radius: 50%;
            background: var(--kpi-glow, rgba(77,141,255,.12));
            filter: blur(3px);
        }

    .ma-kpi-label {
        display: block;
        color: var(--ma-muted);
        font-size: .79rem;
        font-weight: 600;
    }

    .ma-kpi-value {
        display: block;
        margin-top: 7px;
        color: white;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 2.15rem;
        font-weight: 800;
        line-height: 1;
    }

    .ma-kpi-note {
        display: block;
        margin-top: 8px;
        color: #7288ae;
        font-size: .75rem;
    }

    .ma-layout {
        display: grid;
        grid-template-columns: minmax(0,1.55fr) minmax(300px,1fr);
        gap: 18px;
        margin-top: 22px;
        align-items: start;
    }

    .ma-panel {
        overflow: hidden;
        margin-bottom: 18px;
        border: 1px solid var(--ma-line);
        border-radius: 17px;
        background: var(--ma-panel);
    }

    .ma-section-head {
        flex-wrap: wrap;
        padding: 19px 20px;
        border-bottom: 1px solid var(--ma-line);
    }

        .ma-section-head h2 {
            margin: 0;
            color: white;
            font-family: "Barlow Condensed", sans-serif;
            font-size: 1.45rem;
            font-weight: 700;
        }

        .ma-section-head p {
            margin: 4px 0 0;
            color: var(--ma-muted);
            font-size: .82rem;
        }

    .ma-chart-wrap {
        position: relative;
        height: 260px;
        padding: 18px;
    }

        .ma-chart-wrap.short {
            height: 220px;
        }

    .ma-filter-row {
        justify-content: flex-start;
        flex-wrap: wrap;
        padding: 14px 20px 0;
    }

    .ma-filter {
        padding: 8px 11px;
        border: 1px solid var(--ma-line);
        border-radius: 9px;
        background: #0a172b;
        color: #a8bddf;
        font: inherit;
        font-size: .78rem;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .ma-filter:hover, .ma-filter.active {
            border-color: var(--ma-blue);
            background: rgba(77,141,255,.14);
            color: white;
        }

    .ma-events {
        margin: 0;
        padding: 8px 20px 15px;
        list-style: none;
    }

    .ma-event {
        display: grid;
        grid-template-columns: 50px minmax(0,1fr);
        gap: 12px;
        padding: 16px 0;
        border-bottom: 1px solid rgba(35,55,87,.7);
    }

        .ma-event:last-child {
            border-bottom: 0;
        }

        .ma-event[hidden] {
            display: none;
        }

    .ma-minute {
        align-self: start;
        padding: 7px 4px;
        border: 1px solid var(--ma-line);
        border-radius: 8px;
        background: #0a172b;
        color: #c4d7f6;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 1rem;
        font-weight: 700;
        text-align: center;
    }

    .ma-event-main {
        display: flex;
        align-items: flex-start;
        gap: 11px;
    }

    .ma-event-icon {
        display: grid;
        place-items: center;
        flex: 0 0 35px;
        width: 35px;
        height: 35px;
        border-radius: 10px;
        background: #182a49;
        font-size: 1rem;
    }

        .ma-event-icon.goal {
            color: var(--ma-green);
        }

        .ma-event-icon.card {
            color: var(--ma-yellow);
        }

        .ma-event-icon.sub {
            color: var(--ma-cyan);
        }

    .ma-event-player {
        margin: 0;
        color: #edf3ff;
        font-size: .92rem;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .ma-event-detail {
        margin-top: 4px;
        color: var(--ma-muted);
        font-size: .81rem;
    }

    .ma-event-team {
        display: inline-block;
        margin-top: 7px;
        padding: 3px 8px;
        border-radius: 5px;
        background: rgba(77,141,255,.1);
        color: #91baff;
        font-size: .7rem;
    }

    .ma-empty {
        padding: 30px 20px;
        color: var(--ma-muted);
        text-align: center;
    }

    .ma-comparison {
        padding: 20px;
    }

    .ma-compare-row {
        margin-bottom: 23px;
    }

        .ma-compare-row:last-child {
            margin-bottom: 0;
        }

    .ma-compare-numbers {
        display: grid;
        grid-template-columns: 38px minmax(0,1fr) 38px;
        align-items: center;
        gap: 10px;
        margin-bottom: 9px;
    }

    .ma-number {
        color: white;
        font-family: "Barlow Condensed", sans-serif;
        font-size: 1.35rem;
        font-weight: 700;
        text-align: center;
    }

    .ma-compare-label {
        color: #a5b8d9;
        font-size: .83rem;
        text-align: center;
    }

    .ma-bars {
        display: flex;
        gap: 4px;
        height: 7px;
    }

    .ma-bar {
        min-width: 0;
        height: 100%;
        border-radius: 99px;
    }

        .ma-bar.home {
            background: linear-gradient(90deg, var(--ma-blue), var(--ma-cyan));
        }

        .ma-bar.away {
            background: linear-gradient(90deg, var(--ma-purple), #d6baff);
        }

    .ma-insight {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin: 0 20px 20px;
        padding: 14px;
        border: 1px solid rgba(77,141,255,.22);
        border-radius: 12px;
        background: rgba(77,141,255,.07);
    }

    .ma-insight-icon {
        color: var(--ma-cyan);
        font-size: 1.2rem;
    }

    .ma-insight strong {
        display: block;
        color: #eaf2ff;
        font-size: .85rem;
    }

    .ma-insight p {
        margin: 5px 0 0;
        color: #9db2d4;
        font-size: .8rem;
        line-height: 1.55;
    }

    .ma-info {
        margin: 0;
        padding: 7px 20px 15px;
    }

    .ma-info-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 13px 0;
        border-bottom: 1px solid rgba(35,55,87,.7);
    }

        .ma-info-row:last-child {
            border-bottom: 0;
        }

    .ma-info dt {
        color: var(--ma-muted);
        font-size: .83rem;
    }

    .ma-info dd {
        margin: 0;
        color: #e6efff;
        font-size: .83rem;
        font-weight: 600;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .ma-legend {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        padding: 0 20px 17px;
        color: var(--ma-muted);
        font-size: .76rem;
    }

        .ma-legend span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

    .ma-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

        .ma-dot.home {
            background: var(--ma-blue);
        }

        .ma-dot.away {
            background: var(--ma-purple);
        }

    .ma-footer {
        flex-wrap: wrap;
        margin-top: 25px;
        padding-top: 18px;
        border-top: 1px solid var(--ma-line);
        color: #7085a8;
        font-size: .8rem;
    }

        .ma-footer strong {
            color: #a5badc;
            font-family: "Barlow Condensed", sans-serif;
            letter-spacing: .1em;
        }

    @@media (max-width: 900px) {
        .ma-layout {
            grid-template-columns: 1fr;
        }

        .ma-kpis {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width: 600px) {
        .ma-shell {
            width: calc(100% - 22px);
        }

        .ma-page {
            padding-top: 16px;
        }

        .ma-hero {
            padding: 20px 14px;
            border-radius: 17px;
        }

        .ma-hero-top {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .ma-matchup {
            gap: 6px;
            margin-top: 25px;
        }

        .ma-team, .ma-team.away {
            flex-direction: column;
            gap: 8px;
            text-align: center;
        }

        .ma-crest {
            flex-basis: 48px;
            width: 48px;
            height: 48px;
            font-size: 1.4rem;
        }

        .ma-team-name {
            font-size: 1.3rem;
        }

        .ma-team-label {
            font-size: .6rem;
        }

        .ma-score {
            font-size: 3rem;
        }

        .ma-vs {
            font-size: 1.4rem;
        }

        .ma-meta {
            justify-content: flex-start;
            font-size: .76rem;
        }

        .ma-kpi {
            padding: 14px;
        }

        .ma-kpi-value {
            font-size: 1.8rem;
        }

        .ma-section-head {
            padding: 15px;
        }

        .ma-chart-wrap {
            height: 230px;
            padding: 12px;
        }

        .ma-events {
            padding: 8px 13px 13px;
        }

        .ma-event {
            grid-template-columns: 43px minmax(0,1fr);
            gap: 9px;
        }

        .ma-filter-row {
            padding-left: 13px;
            padding-right: 13px;
        }

        .ma-filter {
            flex: 1;
        }

        .ma-comparison {
            padding: 16px;
        }
    }
</style>

<main class="ma-page">
    <div class="ma-shell">
        <a class="ma-back" asp-controller="Fixtures" asp-action="Index" asp-route-week="@Model.Week">← Fikstüre dön</a>

        <section class="ma-hero">
            <div class="ma-hero-top">
                <div class="ma-league">
                    <span class="ma-mark">A</span>
                    <span>Serie A · Match Intelligence</span>
                </div>
                <span class="ma-status @(finished ? "done" : "")">
                    @(finished ? "MAÇ TAMAMLANDI" : (string.IsNullOrWhiteSpace(status) ? "MAÇ DETAYI" : status.ToUpperInvariant()))
                </span>
            </div>

            <div class="ma-matchup">
                <div class="ma-team">
                    <span class="ma-crest">@homeInitial</span>
                    <div>
                        <span class="ma-team-label">EV SAHİBİ</span>
                        <h1 class="ma-team-name">@home</h1>
                    </div>
                </div>

                <div class="ma-scoreboard">
                    @if (hasScore)
                    {
                        <div class="ma-score">@Model.HomeScore<span>:</span>@Model.AwayScore</div>
                    }
                    else
                    {
                        <div class="ma-vs">VS</div>
                    }
                    <div class="ma-time">@(string.IsNullOrWhiteSpace(Model.Time) ? "Saat belirtilmedi" : Model.Time)</div>
                </div>

                <div class="ma-team away">
                    <span class="ma-crest">@awayInitial</span>
                    <div>
                        <span class="ma-team-label">DEPLASMAN</span>
                        <h2 class="ma-team-name">@away</h2>
                    </div>
                </div>
            </div>

            <div class="ma-meta">
                <span>▦ @Model.MatchDate.ToString("dd MMMM yyyy", new CultureInfo("tr-TR"))</span>
                <span>◷ @Model.Time</span>
                <span>⌖ @(string.IsNullOrWhiteSpace(Model.Stadium) ? "Stadyum belirtilmedi" : Model.Stadium)</span>
                <span>◈ @Model.Week. Hafta</span>
            </div>
        </section>

        <section class="ma-kpis">
            <article class="ma-kpi" style="--kpi-glow:rgba(54,214,160,.16)">
                <span class="ma-kpi-label">Toplam gol</span>
                <strong class="ma-kpi-value">@totalGoals</strong>
                <span class="ma-kpi-note">@(hasScore ? "Resmî skor" : "Olay kayıtları")</span>
            </article>
            <article class="ma-kpi" style="--kpi-glow:rgba(77,141,255,.18)">
                <span class="ma-kpi-label">Gol olayı</span>
                <strong class="ma-kpi-value">@goals.Count</strong>
                <span class="ma-kpi-note">Zaman çizelgesindeki goller</span>
            </article>
            <article class="ma-kpi" style="--kpi-glow:rgba(244,196,81,.18)">
                <span class="ma-kpi-label">Kart</span>
                <strong class="ma-kpi-value">@totalCards</strong>
                <span class="ma-kpi-note">@totalYellows sarı · @totalReds kırmızı</span>
            </article>
            <article class="ma-kpi" style="--kpi-glow:rgba(66,214,232,.16)">
                <span class="ma-kpi-label">Oyuncu değişikliği</span>
                <strong class="ma-kpi-value">@totalSubs</strong>
                <span class="ma-kpi-note">Kayıtlı değişiklikler</span>
            </article>
        </section>

        <div class="ma-layout">
            <div>
                <section class="ma-panel">
                    <div class="ma-section-head">
                        <div>
                            <h2>Gol zamanları</h2>
                            <p>Gol olaylarının maç içindeki dağılımı</p>
                        </div>
                    </div>
                    @if (goals.Any())
                    {
                        <div class="ma-chart-wrap">
                            <canvas id="goalTimelineChart" aria-label="Gol dakikaları grafiği"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="ma-empty">Bu maç için gol olayı kaydı bulunmuyor.</div>
                    }
                </section>

                <section class="ma-panel">
                    <div class="ma-section-head">
                        <div>
                            <h2>Maç olayları</h2>
                            <p>Gol, kart ve oyuncu değişikliği zaman çizelgesi</p>
                        </div>
                    </div>

                    <div class="ma-filter-row" role="group" aria-label="Olay filtresi">
                        <button class="ma-filter active" type="button" data-filter="all">Tümü</button>
                        <button class="ma-filter" type="button" data-filter="goal">⚽ Goller</button>
                        <button class="ma-filter" type="button" data-filter="card">▰ Kartlar</button>
                        <button class="ma-filter" type="button" data-filter="sub">⇄ Değişiklikler</button>
                    </div>

                    @if (events.Any())
                    {
                        <ol class="ma-events">
                            @foreach (var ev in events)
                            {
                                var icon = ev.Type == "goal" ? "⚽" : ev.Type == "card" ? "▰" : "⇄";
                                var iconClass = ev.Type;
                                var cardIsRed = ev.Type == "card" && ev.Detail.Contains("Kırmızı", StringComparison.OrdinalIgnoreCase);

                                <li class="ma-event" data-event-type="@ev.Type">
                                    <span class="ma-minute">@ev.Minute'</span>
                                    <div class="ma-event-main">
                                        <span class="ma-event-icon @iconClass" style="@(cardIsRed ? "color:var(--ma-red)" : "")">@icon</span>
                                        <div>
                                            <p class="ma-event-player">@ev.Player</p>
                                            <div class="ma-event-detail">@ev.Detail</div>
                                            <span class="ma-event-team">@ev.Team</span>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="ma-empty">Bu maç için henüz olay kaydı bulunmuyor.</div>
                    }
                </section>
            </div>

            <aside>
                <section class="ma-panel">
                    <div class="ma-section-head">
                        <div>
                            <h2>Takım karşılaştırması</h2>
                            <p>Mevcut olay kayıtlarına göre</p>
                        </div>
                    </div>

                    <div class="ma-comparison">
                        @{
                            var goalSum = Math.Max(1, homeGoals + awayGoals);
                            var yellowSum = Math.Max(1, homeYellow + awayYellow);
                            var redSum = Math.Max(1, homeRed + awayRed);
                            var subHome = substitutions.Count(x => string.Equals(x.Team, home, StringComparison.OrdinalIgnoreCase));
                            var subAway = substitutions.Count(x => string.Equals(x.Team, away, StringComparison.OrdinalIgnoreCase));
                            var subSum = Math.Max(1, subHome + subAway);
                        }

                        <div class="ma-compare-row">
                            <div class="ma-compare-numbers">
                                <span class="ma-number">@homeGoals</span>
                                <span class="ma-compare-label">Gol kayıtları</span>
                                <span class="ma-number">@awayGoals</span>
                            </div>
                            <div class="ma-bars">
                                <span class="ma-bar home" style="width:@(homeGoals * 100.0 / goalSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                                <span class="ma-bar away" style="width:@(awayGoals * 100.0 / goalSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                            </div>
                        </div>

                        <div class="ma-compare-row">
                            <div class="ma-compare-numbers">
                                <span class="ma-number">@homeYellow</span>
                                <span class="ma-compare-label">Sarı kart</span>
                                <span class="ma-number">@awayYellow</span>
                            </div>
                            <div class="ma-bars">
                                <span class="ma-bar home" style="width:@(homeYellow * 100.0 / yellowSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                                <span class="ma-bar away" style="width:@(awayYellow * 100.0 / yellowSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                            </div>
                        </div>

                        <div class="ma-compare-row">
                            <div class="ma-compare-numbers">
                                <span class="ma-number">@homeRed</span>
                                <span class="ma-compare-label">Kırmızı kart</span>
                                <span class="ma-number">@awayRed</span>
                            </div>
                            <div class="ma-bars">
                                <span class="ma-bar home" style="width:@(homeRed * 100.0 / redSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                                <span class="ma-bar away" style="width:@(awayRed * 100.0 / redSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                            </div>
                        </div>

                        <div class="ma-compare-row">
                            <div class="ma-compare-numbers">
                                <span class="ma-number">@subHome</span>
                                <span class="ma-compare-label">Değişiklik</span>
                                <span class="ma-number">@subAway</span>
                            </div>
                            <div class="ma-bars">
                                <span class="ma-bar home" style="width:@(subHome * 100.0 / subSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                                <span class="ma-bar away" style="width:@(subAway * 100.0 / subSum).ToString(" 0.##", CultureInfo.InvariantCulture)%"></span>
                            </div>
                        </div>
                    </div>

                    <div class="ma-legend">
                        <span><i class="ma-dot home"></i>@home</span>
                        <span><i class="ma-dot away"></i>@away</span>
                    </div>

                    <div class="ma-insight">
                        <span class="ma-insight-icon">✦</span>
                        <div>
                            <strong>Maç analizi</strong>
                            <p>
                                @if (hasScore)
                                {
                                    if (Model.HomeScore > Model.AwayScore)
                                    {
                                        <span>@home, karşılaşmayı @Model.HomeScore–@Model.AwayScore skoruyla kazandı.</span>
                                    }
                                    else if (Model.HomeScore < Model.AwayScore)
                                    {
                                        <span>@away, karşılaşmayı @Model.AwayScore–@Model.HomeScore skoruyla kazandı.</span>
                                    }
                                    else
                                    {
                                        <span>Karşılaşma @Model.HomeScore–@Model.AwayScore beraberlikle sonuçlandı.</span>
                                    }
                                }
                                else
                                {
                                    <span>Skor henüz belli değil. Olay kayıtları geldikçe analizler güncellenir.</span>
                                }
                            </p>
                        </div>
                    </div>
                </section>

                <section class="ma-panel">
                    <div class="ma-section-head">
                        <div>
                            <h2>Karşılaşma bilgileri</h2>
                            <p>Maçın temel bilgileri</p>
                        </div>
                    </div>
                    <dl class="ma-info">
                        <div class="ma-info-row"><dt>Organizasyon</dt><dd>Serie A</dd></div>
                        <div class="ma-info-row"><dt>Hafta</dt><dd>@Model.Week</dd></div>
                        <div class="ma-info-row"><dt>Durum</dt><dd>@Model.Status</dd></div>
                        <div class="ma-info-row"><dt>Tarih</dt><dd>@Model.MatchDate.ToString("dd.MM.yyyy")</dd></div>
                        <div class="ma-info-row"><dt>Saat</dt><dd>@Model.Time</dd></div>
                        <div class="ma-info-row"><dt>Stadyum</dt><dd>@(string.IsNullOrWhiteSpace(Model.Stadium) ? "Belirtilmedi" : Model.Stadium)</dd></div>
                    </dl>
                </section>

                <section class="ma-panel">
                    <div class="ma-section-head">
                        <div>
                            <h2>Kart dağılımı</h2>
                            <p>Takımlara göre kart sayısı</p>
                        </div>
                    </div>
                    @if (cards.Any())
                    {
                        <div class="ma-chart-wrap short">
                            <canvas id="cardsChart" aria-label="Kart dağılımı grafiği"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="ma-empty">Kart kaydı bulunmuyor.</div>
                    }
                </section>
            </aside>
        </div>

        <footer class="ma-footer">
            <strong>SERIE A · MATCH INTELLIGENCE</strong>
            <span>Analizler mevcut API kayıtlarından hesaplanır.</span>
        </footer>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const filterButtons = document.querySelectorAll("[data-filter]");
        const eventItems = document.querySelectorAll("[data-event-type]");

        filterButtons.forEach(button => {
            button.addEventListener("click", () => {
                const filter = button.dataset.filter;

                filterButtons.forEach(item => item.classList.toggle("active", item === button));

                eventItems.forEach(item => {
                    item.hidden = filter !== "all" && item.dataset.eventType !== filter;
                });
            });
        });

        if (typeof Chart === "undefined") return;

        Chart.defaults.color = "#91a5c8";
        Chart.defaults.font.family = "Barlow, sans-serif";

        const goalCanvas = document.getElementById("goalTimelineChart");
        if (goalCanvas) {
            const goalLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(goalBucketLabels));
            const goalData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(goalBuckets));

            new Chart(goalCanvas, {
                type: "bar",
                data: {
                    labels: goalLabels,
                    datasets: [{
                        label: "Gol",
                        data: goalData,
                        backgroundColor: ["#4d8dff", "#42d6e8", "#36d6a0", "#a98bff", "#f4c451", "#ff7890"],
                        borderRadius: 8,
                        borderSkipped: false,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { displayColors: false }
                    },
                    scales: {
                        x: { grid: { display: false }, border: { display: false } },
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, stepSize: 1 },
                            grid: { color: "rgba(145,165,200,.12)" },
                            border: { display: false }
                        }
                    }
                }
            });
        }

        const cardsCanvas = document.getElementById("cardsChart");
        if (cardsCanvas) {
            const cardLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] { home, away }));
            const yellowData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] { homeYellow, awayYellow }));
            const redData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new[] { homeRed, awayRed }));

            new Chart(cardsCanvas, {
                type: "bar",
                data: {
                    labels: cardLabels,
                    datasets: [
                        {
                            label: "Sarı kart",
                            data: yellowData,
                            backgroundColor: "#f4c451",
                            borderRadius: 6
                        },
                        {
                            label: "Kırmızı kart",
                            data: redData,
                            backgroundColor: "#ff6177",
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    indexAxis: "y",
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: "bottom",
                            labels: { usePointStyle: true, boxWidth: 8, padding: 18 }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { precision: 0, stepSize: 1 },
                            grid: { color: "rgba(145,165,200,.12)" },
                            border: { display: false }
                        },
                        y: { grid: { display: false }, border: { display: false } }
                    }
                }
            });
        }
    });
</script>
