@model SerieA.WebUI.ViewModels.MatchDetailViewModel

@{
    ViewData["Title"] = "Maç Merkezi";

    var goals = Model.Goals ?? new List<SerieA.WebUI.ViewModels.MatchGoalViewModel>();
    var cards = Model.Cards ?? new List<SerieA.WebUI.ViewModels.MatchCardViewModel>();
    var substitutions = Model.Substitutions ?? new List<SerieA.WebUI.ViewModels.MatchSubstitutionViewModel>();

    var allEvents = new List<dynamic>();

    foreach (var goal in goals)
    {
        allEvents.Add(new
        {
            Type = "goal",
            Minute = goal.Minute,
            Player = goal.PlayerName,
            Team = goal.Team,
            CardType = "",
            PlayerOut = "",
            PlayerIn = ""
        });
    }

    foreach (var card in cards)
    {
        allEvents.Add(new
        {
            Type = card.CardType?.ToLower().Contains("kırmızı") == true ||
                   card.CardType?.ToLower().Contains("red") == true
                   ? "redcard"
                   : "yellowcard",
            Minute = card.Minute,
            Player = card.PlayerName,
            Team = card.Team,
            CardType = card.CardType,
            PlayerOut = "",
            PlayerIn = ""
        });
    }

    foreach (var sub in substitutions)
    {
        allEvents.Add(new
        {
            Type = "substitution",
            Minute = sub.Minute,
            Player = "",
            Team = sub.Team,
            CardType = "",
            PlayerOut = sub.PlayerOut,
            PlayerIn = sub.PlayerIn
        });
    }

    allEvents = allEvents
        .OrderBy(x => x.Minute)
        .ToList();

    var homeGoals = goals.Count(x => x.Team == Model.HomeTeam);
    var awayGoals = goals.Count(x => x.Team == Model.AwayTeam);

    var homeYellowCards = cards.Count(x =>
        x.Team == Model.HomeTeam &&
        (
            x.CardType?.ToLower().Contains("sarı") == true ||
            x.CardType?.ToLower().Contains("yellow") == true
        ));

    var awayYellowCards = cards.Count(x =>
        x.Team == Model.AwayTeam &&
        (
            x.CardType?.ToLower().Contains("sarı") == true ||
            x.CardType?.ToLower().Contains("yellow") == true
        ));

    var homeRedCards = cards.Count(x =>
        x.Team == Model.HomeTeam &&
        (
            x.CardType?.ToLower().Contains("kırmızı") == true ||
            x.CardType?.ToLower().Contains("red") == true
        ));

    var awayRedCards = cards.Count(x =>
        x.Team == Model.AwayTeam &&
        (
            x.CardType?.ToLower().Contains("kırmızı") == true ||
            x.CardType?.ToLower().Contains("red") == true
        ));

    var homeSubs = substitutions.Count(x => x.Team == Model.HomeTeam);
    var awaySubs = substitutions.Count(x => x.Team == Model.AwayTeam);

    var totalGoals = goals.Count;
    var totalCards = cards.Count;
    var totalSubs = substitutions.Count;
    var totalEvents = allEvents.Count;

    var homeScore = Model.HomeScore ?? homeGoals;
    var awayScore = Model.AwayScore ?? awayGoals;

    string resultText;

    if (Model.Status?.ToLower().Contains("tamam") == true)
    {
        if (homeScore > awayScore)
            resultText = $"{Model.HomeTeam} kazandı";
        else if (awayScore > homeScore)
            resultText = $"{Model.AwayTeam} kazandı";
        else
            resultText = "Maç berabere bitti";
    }
    else
    {
        resultText = Model.Status;
    }

    var resultClass =
        homeScore > awayScore ? "home-win" :
        awayScore > homeScore ? "away-win" :
        "draw";

    var firstGoal = goals
        .OrderBy(x => x.Minute)
        .FirstOrDefault();

    var lastGoal = goals
        .OrderByDescending(x => x.Minute)
        .FirstOrDefault();

    var uniquePlayers = goals
        .Select(x => x.PlayerName)
        .Concat(cards.Select(x => x.PlayerName))
        .Concat(substitutions.SelectMany(x => new[] { x.PlayerOut, x.PlayerIn }))
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    var homeEvents = allEvents.Count(x => x.Team == Model.HomeTeam);
    var awayEvents = allEvents.Count(x => x.Team == Model.AwayTeam);

    var homeEventPercentage = totalEvents > 0
        ? Math.Round((double)homeEvents / totalEvents * 100)
        : 50;

    var awayEventPercentage = totalEvents > 0
        ? 100 - homeEventPercentage
        : 50;

    var homeGoalPercentage = totalGoals > 0
        ? Math.Round((double)homeGoals / totalGoals * 100)
        : 50;

    var awayGoalPercentage = totalGoals > 0
        ? 100 - homeGoalPercentage
        : 50;

    var dateText = Model.MatchDate.ToString(
        "dd MMMM yyyy",
        new System.Globalization.CultureInfo("tr-TR")
    );

    var homeInitial =
        !string.IsNullOrWhiteSpace(Model.HomeTeam)
            ? Model.HomeTeam.Substring(0, 1).ToUpper()
            : "H";

    var awayInitial =
        !string.IsNullOrWhiteSpace(Model.AwayTeam)
            ? Model.AwayTeam.Substring(0, 1).ToUpper()
            : "A";

    string LogoFallback(string logoUrl, string initial)
    {
        return string.IsNullOrWhiteSpace(logoUrl)
            ? $"https://ui-avatars.com/api/?name={initial}&background=0b6b43&color=fff&bold=true&size=256"
            : logoUrl;
    }
}

<style>
    :root {
        --green: #00b86b;
        --green-dark: #075c3d;
        --green-deep: #03271b;
        --green-soft: #e9fff5;
        --black: #07110d;
        --dark: #0b1712;
        --dark2: #102119;
        --card: #ffffff;
        --text: #102019;
        --muted: #718079;
        --border: #e7eee9;
        --red: #ef4444;
        --yellow: #f4b400;
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #06110e;
    }

    .match-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 18px 70px;
    }

    /* TOP BAR */

    .match-topbar {
        background: linear-gradient(135deg, #031c13, #075b3d 55%, #00a968);
        border-radius: 24px;
        padding: 16px 22px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 18px 45px rgba(3, 50, 34, .22);
        position: relative;
        overflow: hidden;
    }

        .match-topbar::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -100px;
            top: -160px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

    .brand-area {
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        z-index: 2;
    }

    .brand-ball {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        font-size: 23px;
    }

    .brand-title {
        font-weight: 900;
        font-size: 20px;
        letter-spacing: -.5px;
    }

    .brand-sub {
        font-size: 11px;
        opacity: .65;
        margin-top: 2px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .live-clock {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 15px;
        border-radius: 12px;
        background: rgba(0,0,0,.18);
        font-weight: 700;
        font-size: 13px;
    }

    .live-dot {
        width: 8px;
        height: 8px;
        background: #5dffad;
        border-radius: 50%;
        box-shadow: 0 0 12px #5dffad;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        50% {
            opacity: .35;
            transform: scale(.7);
        }
    }

    /* MATCH HERO */

    .match-hero {
        margin-top: 18px;
        border-radius: 30px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(3,28,19,.98), rgba(7,91,61,.96));
        color: white;
        position: relative;
        box-shadow: 0 25px 65px rgba(3, 46, 31, .24);
    }

        .match-hero::before {
            content: "";
            position: absolute;
            width: 650px;
            height: 650px;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 50%;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
        }

    .hero-content {
        position: relative;
        z-index: 2;
        padding: 30px 35px 35px;
    }

    .match-meta {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .meta-pill {
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.12);
        padding: 8px 13px;
        border-radius: 999px;
        font-size: 12px;
        color: rgba(255,255,255,.84);
    }

    .status-pill {
        background: #00c875;
        color: #03271b;
        font-weight: 900;
    }

    .teams-row {
        display: grid;
        grid-template-columns: 1fr 230px 1fr;
        align-items: center;
        gap: 25px;
    }

    .team-box {
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .team-box.away {
            flex-direction: row-reverse;
            text-align: right;
        }

    .team-logo {
        width: 110px;
        height: 110px;
        border-radius: 28px;
        padding: 13px;
        object-fit: contain;
        background: rgba(255,255,255,.97);
        box-shadow: 0 15px 35px rgba(0,0,0,.25), inset 0 0 0 1px rgba(0,0,0,.04);
        transition: .3s ease;
    }

        .team-logo:hover {
            transform: translateY(-5px) scale(1.04);
        }

    .team-name {
        font-size: clamp(21px, 2vw, 31px);
        font-weight: 950;
        letter-spacing: -1px;
    }

    .team-code {
        margin-top: 5px;
        font-size: 11px;
        color: rgba(255,255,255,.48);
        font-weight: 800;
        letter-spacing: 2px;
    }

    .score-box {
        text-align: center;
    }

    .score {
        font-size: clamp(50px, 7vw, 82px);
        font-weight: 950;
        letter-spacing: -6px;
        line-height: .9;
    }

    .score-separator {
        margin: 0 5px;
        opacity: .3;
    }

    .result-text {
        margin-top: 14px;
        font-size: 12px;
        font-weight: 800;
        color: #78ffbd;
    }

    .match-info {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    .info-item {
        padding: 9px 14px;
        border-radius: 12px;
        background: rgba(0,0,0,.15);
        font-size: 12px;
        color: rgba(255,255,255,.75);
    }

    /* KPI */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-top: 18px;
    }

    .kpi {
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 8px 25px rgba(16,32,25,.05);
        position: relative;
        overflow: hidden;
    }

        .kpi::after {
            content: "";
            position: absolute;
            right: -25px;
            bottom: -35px;
            width: 90px;
            height: 90px;
            background: var(--green-soft);
            border-radius: 50%;
        }

    .kpi-icon {
        font-size: 21px;
    }

    .kpi-value {
        margin-top: 7px;
        font-size: 27px;
        font-weight: 950;
        color: var(--green-dark);
    }

    .kpi-label {
        color: var(--muted);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    /* MAIN */

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(330px, .8fr);
        gap: 18px;
        margin-top: 18px;
    }

    .panel {
        background: white;
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 22px;
        box-shadow: 0 8px 28px rgba(16,32,25,.05);
    }

        .panel + .panel {
            margin-top: 18px;
        }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 17px;
        font-weight: 950;
        color: var(--text);
    }

    .panel-title-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--green-soft);
    }

    .panel-badge {
        font-size: 10px;
        font-weight: 900;
        color: var(--green-dark);
        background: var(--green-soft);
        padding: 7px 10px;
        border-radius: 999px;
    }

    /* EVENTS */

    .events-list {
        position: relative;
    }

        .events-list::before {
            content: "";
            position: absolute;
            left: 42px;
            top: 5px;
            bottom: 5px;
            width: 2px;
            background: linear-gradient(var(--green), #dcefe6);
        }

    .event {
        display: grid;
        grid-template-columns: 65px 42px 1fr;
        align-items: center;
        gap: 12px;
        min-height: 65px;
        position: relative;
    }

    .event-minute {
        text-align: right;
        font-weight: 950;
        font-size: 12px;
        color: var(--green-dark);
    }

    .event-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 2px solid var(--border);
        position: relative;
        z-index: 2;
        font-size: 15px;
    }

    .event.goal .event-icon {
        border-color: #00b86b;
        background: #eafff5;
    }

    .event.yellowcard .event-icon {
        border-color: #f4b400;
        background: #fff9df;
    }

    .event.redcard .event-icon {
        border-color: #ef4444;
        background: #fff0f0;
    }

    .event.substitution .event-icon {
        border-color: #5b8def;
        background: #eff4ff;
    }

    .event-content {
        background: #f8faf9;
        border: 1px solid #edf2ef;
        border-radius: 14px;
        padding: 11px 14px;
    }

    .event-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .event-player {
        font-weight: 900;
        font-size: 13px;
        color: var(--text);
    }

    .event-team {
        font-size: 10px;
        font-weight: 800;
        color: var(--muted);
    }

    .event-desc {
        margin-top: 4px;
        font-size: 11px;
        color: var(--muted);
    }

    .empty-events {
        text-align: center;
        padding: 40px 15px;
        color: var(--muted);
        background: #f8faf9;
        border-radius: 15px;
    }

    /* ANALYSIS */

    .comparison {
        display: grid;
        grid-template-columns: 1fr 70px 1fr;
        gap: 12px;
        align-items: center;
    }

    .comparison-team {
        font-weight: 900;
        font-size: 13px;
    }

        .comparison-team.right {
            text-align: right;
        }

    .comparison-value {
        font-size: 22px;
        font-weight: 950;
        color: var(--green-dark);
        text-align: center;
    }

    .bar-wrap {
        grid-column: 1 / -1;
        height: 9px;
        border-radius: 99px;
        background: #edf2ef;
        overflow: hidden;
        display: flex;
    }

    .bar-home {
        background: linear-gradient(90deg, #08794f, #00c875);
        height: 100%;
    }

    .bar-away {
        background: linear-gradient(90deg, #74d9ad, #b9efda);
        height: 100%;
    }

    .stat-row {
        margin-bottom: 22px;
    }

        .stat-row:last-child {
            margin-bottom: 0;
        }

    .stat-label {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        font-weight: 800;
        color: var(--muted);
        margin-bottom: 8px;
    }

    /* TEAM CARDS */

    .team-card {
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 17px;
        background: linear-gradient(145deg, #fff, #f8fbf9);
    }

        .team-card + .team-card {
            margin-top: 12px;
        }

    .team-card-head {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .small-logo {
        width: 52px;
        height: 52px;
        object-fit: contain;
        border-radius: 14px;
        padding: 7px;
        background: white;
        border: 1px solid var(--border);
    }

    .team-card-name {
        font-weight: 950;
        font-size: 16px;
    }

    .team-card-sub {
        color: var(--muted);
        font-size: 11px;
        margin-top: 2px;
    }

    .team-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 15px;
    }

    .team-stat {
        text-align: center;
        background: white;
        border: 1px solid var(--border);
        padding: 10px 5px;
        border-radius: 12px;
    }

    .team-stat-value {
        font-size: 17px;
        font-weight: 950;
        color: var(--green-dark);
    }

    .team-stat-label {
        font-size: 9px;
        color: var(--muted);
        text-transform: uppercase;
        font-weight: 800;
        margin-top: 2px;
    }

    /* PLAYER LIST */

    .player-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 0;
        border-bottom: 1px solid #eef2ef;
    }

        .player-row:last-child {
            border-bottom: 0;
        }

    .player-number {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--green-soft);
        color: var(--green-dark);
        border-radius: 9px;
        font-size: 10px;
        font-weight: 950;
    }

    .player-name {
        font-size: 12px;
        font-weight: 850;
        flex: 1;
    }

    .player-team {
        font-size: 9px;
        color: var(--muted);
    }

    .player-event {
        font-size: 12px;
    }

    /* HIGHLIGHTS */

    .highlight-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .highlight {
        padding: 14px;
        background: #f7faf8;
        border: 1px solid #e8efeb;
        border-radius: 15px;
    }

    .highlight-icon {
        font-size: 18px;
    }

    .highlight-value {
        font-size: 17px;
        font-weight: 950;
        margin-top: 7px;
        color: var(--green-dark);
    }

    .highlight-label {
        font-size: 9px;
        color: var(--muted);
        text-transform: uppercase;
        font-weight: 800;
        margin-top: 2px;
    }

    /* RESULT */

    .result-card {
        text-align: center;
        border-radius: 18px;
        padding: 20px;
        background: linear-gradient(135deg, #03271b, #08794f);
        color: white;
    }

    .result-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        opacity: .65;
        font-weight: 900;
    }

    .result-title {
        font-size: 21px;
        font-weight: 950;
        margin-top: 6px;
    }

    .result-score {
        font-size: 37px;
        font-weight: 950;
        margin-top: 8px;
        letter-spacing: -2px;
    }

    /* FOOTER */

    .match-footer {
        margin-top: 18px;
        padding: 17px 20px;
        border-radius: 18px;
        background: #07150f;
        color: rgba(255,255,255,.65);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        font-size: 11px;
    }

    .footer-brand {
        color: #67e8ae;
        font-weight: 950;
    }

    /* RESPONSIVE */

    @@media (max-width: 1050px) {
        .content-grid {
            grid-template-columns: 1fr;
        }

        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .match-page {
            padding: 12px 10px 45px;
        }

        .match-topbar {
            border-radius: 18px;
        }

        .brand-sub {
            display: none;
        }

        .hero-content {
            padding: 22px 15px 25px;
        }

        .teams-row {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .team-box,
        .team-box.away {
            flex-direction: column;
            text-align: center;
        }

        .score-box {
            order: -1;
        }

        .team-logo {
            width: 82px;
            height: 82px;
        }

        .score {
            font-size: 55px;
        }

        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 9px;
        }

        .kpi {
            padding: 13px;
        }

        .kpi-value {
            font-size: 22px;
        }

        .panel {
            padding: 15px;
            border-radius: 17px;
        }

        .comparison {
            grid-template-columns: 1fr 50px 1fr;
        }

        .highlight-grid {
            grid-template-columns: 1fr 1fr;
        }

        .match-footer {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<div class="match-page">

    <!-- TOP NAV -->
    <div class="match-topbar">
        <div class="brand-area">
            <div class="brand-ball">⚽</div>

            <div>
                <div class="brand-title">SERIE A MATCH CENTER</div>
                <div class="brand-sub">Live Football Statistics</div>
            </div>
        </div>

        <div class="live-clock">
            <span class="live-dot"></span>
            <span id="matchClock">MAÇ MERKEZİ</span>
        </div>
    </div>

    <!-- HERO -->
    <section class="match-hero">

        <div class="hero-content">

            <div class="match-meta">

                <span class="meta-pill">
                    🏆 SERIE A
                </span>

                <span class="meta-pill">
                    HAFTA @Model.Week
                </span>

                <span class="meta-pill">
                    📅 @dateText
                </span>

                <span class="meta-pill status-pill">
                    @Model.Status
                </span>

            </div>

            <div class="teams-row">

                <!-- HOME -->
                <div class="team-box">

                    <img class="team-logo"
                         src="@Model.HomeTeamLogoUrl"
                         alt="@Model.HomeTeam"
                         onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(homeInitial)&background=075c3d&color=fff&bold=true&size=256';" />

                    <div>
                        <div class="team-name">
                            @Model.HomeTeam
                        </div>

                        <div class="team-code">
                            EV SAHİBİ
                        </div>
                    </div>

                </div>

                <!-- SCORE -->
                <div class="score-box">

                    <div class="score">
                        @homeScore
                        <span class="score-separator">-</span>
                        @awayScore
                    </div>

                    <div class="result-text">
                        @resultText
                    </div>

                </div>

                <!-- AWAY -->
                <div class="team-box away">

                    <img class="team-logo"
                         src="@Model.AwayTeamLogoUrl"
                         alt="@Model.AwayTeam"
                         onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(awayInitial)&background=075c3d&color=fff&bold=true&size=256';" />

                    <div>
                        <div class="team-name">
                            @Model.AwayTeam
                        </div>

                        <div class="team-code">
                            DEPLASMAN
                        </div>
                    </div>

                </div>

            </div>

            <div class="match-info">

                <div class="info-item">
                    🏟️ @Model.Stadium
                </div>

                <div class="info-item">
                    🕐 @Model.Time
                </div>

                <div class="info-item">
                    📅 @dateText
                </div>

            </div>

        </div>

    </section>


    <!-- KPI -->
    <section class="kpi-grid">

        <div class="kpi">
            <div class="kpi-icon">⚽</div>
            <div class="kpi-value">@totalGoals</div>
            <div class="kpi-label">Toplam Gol</div>
        </div>

        <div class="kpi">
            <div class="kpi-icon">🟨</div>
            <div class="kpi-value">@totalCards</div>
            <div class="kpi-label">Toplam Kart</div>
        </div>

        <div class="kpi">
            <div class="kpi-icon">🔄</div>
            <div class="kpi-value">@totalSubs</div>
            <div class="kpi-label">Değişiklik</div>
        </div>

        <div class="kpi">
            <div class="kpi-icon">👤</div>
            <div class="kpi-value">@uniquePlayers.Count</div>
            <div class="kpi-label">Olaylardaki Oyuncu</div>
        </div>

    </section>


    <!-- MAIN -->
    <div class="content-grid">

        <!-- LEFT -->
        <main>

            <!-- MAÇ OLAYLARI -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">⚡</span>
                        Maç Olayları
                    </div>

                    <span class="panel-badge">
                        @totalEvents OLAY
                    </span>

                </div>

                @if (allEvents.Any())
                {
                    <div class="events-list">

                        @foreach (var item in allEvents)
                        {
                            <div class="event @item.Type">

                                <div class="event-minute">
                                    @item.Minute'
                                </div>

                                <div class="event-icon">

                                    @if (item.Type == "goal")
                                    {
                                        <span>⚽</span>
                                    }
                                    else if (item.Type == "yellowcard")
                                    {
                                        <span>🟨</span>
                                    }
                                    else if (item.Type == "redcard")
                                    {
                                        <span>🟥</span>
                                    }
                                    else
                                    {
                                        <span>🔄</span>
                                    }

                                </div>

                                <div class="event-content">

                                    <div class="event-top">

                                        @if (item.Type == "goal")
                                        {
                                            <div class="event-player">
                                                @item.Player
                                            </div>

                                            <div class="event-team">
                                                @item.Team
                                            </div>
                                        }
                                        else if (item.Type == "yellowcard")
                                        {
                                            <div class="event-player">
                                                @item.Player
                                            </div>

                                            <div class="event-team">
                                                @item.Team
                                            </div>
                                        }
                                        else if (item.Type == "redcard")
                                        {
                                            <div class="event-player">
                                                @item.Player
                                            </div>

                                            <div class="event-team">
                                                @item.Team
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="event-player">
                                                @item.PlayerOut
                                                <span style="opacity:.45;">→</span>
                                                @item.PlayerIn
                                            </div>

                                            <div class="event-team">
                                                @item.Team
                                            </div>
                                        }

                                    </div>

                                    <div class="event-desc">

                                        @if (item.Type == "goal")
                                        {
                                            <span>Gol</span>
                                        }
                                        else if (item.Type == "yellowcard")
                                        {
                                            <span>@item.CardType</span>
                                        }
                                        else if (item.Type == "redcard")
                                        {
                                            <span>@item.CardType</span>
                                        }
                                        else
                                        {
                                            <span>Oyuncu değişikliği</span>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-events">
                        <div style="font-size:35px;">⚽</div>
                        <strong>Henüz maç olayı bulunmuyor</strong>
                        <div style="margin-top:5px;font-size:11px;">
                            Bu maç için gol, kart veya oyuncu değişikliği kaydı yok.
                        </div>
                    </div>
                }

            </section>


            <!-- MAÇ ANALİZİ -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">📊</span>
                        Maç Analizi
                    </div>

                    <span class="panel-badge">
                        VERİ TABANI ANALİZİ
                    </span>

                </div>


                <!-- GOL -->
                <div class="stat-row">

                    <div class="stat-label">
                        <span>@Model.HomeTeam</span>
                        <strong>Gol</strong>
                        <span>@Model.AwayTeam</span>
                    </div>

                    <div class="comparison">

                        <div class="comparison-team">
                            @homeGoals
                        </div>

                        <div class="comparison-value">
                            ⚽
                        </div>

                        <div class="comparison-team right">
                            @awayGoals
                        </div>

                        <div class="bar-wrap">
                            <div class="bar-home" style="width:@homeGoalPercentage%"></div>
                            <div class="bar-away" style="width:@awayGoalPercentage%"></div>
                        </div>

                    </div>

                </div>


                <!-- KART -->
                <div class="stat-row">

                    <div class="stat-label">
                        <span>@Model.HomeTeam</span>
                        <strong>Kart</strong>
                        <span>@Model.AwayTeam</span>
                    </div>

                    <div class="comparison">

                        <div class="comparison-team">
                            @(homeYellowCards + homeRedCards)
                        </div>

                        <div class="comparison-value">
                            🟨
                        </div>

                        <div class="comparison-team right">
                            @(awayYellowCards + awayRedCards)
                        </div>

                        <div class="bar-wrap">

                            @{
                                var totalTeamCards =
                                homeYellowCards + homeRedCards +
                                awayYellowCards + awayRedCards;

                                var homeCardPercent =
                                totalTeamCards > 0
                                ? (double)(homeYellowCards + homeRedCards) / totalTeamCards * 100
                                : 50;

                                var awayCardPercent =
                                totalTeamCards > 0
                                ? 100 - homeCardPercent
                                : 50;
                            }

                            <div class="bar-home" style="width:@homeCardPercent%"></div>
                            <div class="bar-away" style="width:@awayCardPercent%"></div>

                        </div>

                    </div>

                </div>


                <!-- DEĞİŞİKLİK -->
                <div class="stat-row">

                    <div class="stat-label">
                        <span>@Model.HomeTeam</span>
                        <strong>Değişiklik</strong>
                        <span>@Model.AwayTeam</span>
                    </div>

                    <div class="comparison">

                        <div class="comparison-team">
                            @homeSubs
                        </div>

                        <div class="comparison-value">
                            🔄
                        </div>

                        <div class="comparison-team right">
                            @awaySubs
                        </div>

                        <div class="bar-wrap">

                            @{
                                var totalSubTeam = homeSubs + awaySubs;

                                var homeSubPercent =
                                totalSubTeam > 0
                                ? (double)homeSubs / totalSubTeam * 100
                                : 50;

                                var awaySubPercent =
                                totalSubTeam > 0
                                ? 100 - homeSubPercent
                                : 50;
                            }

                            <div class="bar-home" style="width:@homeSubPercent%"></div>
                            <div class="bar-away" style="width:@awaySubPercent%"></div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- GOL ZAMANLARI -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">⏱️</span>
                        Gol Zamanları
                    </div>

                    <span class="panel-badge">
                        @totalGoals GOL
                    </span>

                </div>

                @if (goals.Any())
                {
                    <div style="position:relative;height:85px;margin-top:10px;">

                        <div style="
                                    position:absolute;
                                    left:0;
                                    right:0;
                                    top:40px;
                                    height:5px;
                                    border-radius:10px;
                                    background:linear-gradient(90deg,#075c3d,#00c875,#075c3d);">
                        </div>

                        @foreach (var goal in goals.OrderBy(x => x.Minute))
                        {
                            var position = Math.Min(96, Math.Max(2, goal.Minute / 90.0 * 100));

                            <div style="
                                                position:absolute;
                                                left:@position%;
                                                top:20px;
                                                transform:translateX(-50%);
                                                text-align:center;">

                                <div style="
                                                    width:38px;
                                                    height:38px;
                                                    border-radius:50%;
                                                    background:#e9fff5;
                                                    border:2px solid #00b86b;
                                                    display:flex;
                                                    align-items:center;
                                                    justify-content:center;
                                                    font-size:15px;
                                                    box-shadow:0 5px 15px rgba(0,184,107,.15);">
                                    ⚽
                                </div>

                                <div style="
                                                    margin-top:6px;
                                                    font-size:10px;
                                                    font-weight:900;
                                                    white-space:nowrap;">
                                    @goal.Minute'
                                </div>

                            </div>
                        }

                    </div>

                    <div style="
                                display:flex;
                                justify-content:space-between;
                                color:#8a9690;
                                font-size:9px;
                                font-weight:800;
                                margin-top:5px;">
                        <span>0'</span>
                        <span>15'</span>
                        <span>30'</span>
                        <span>45'</span>
                        <span>60'</span>
                        <span>75'</span>
                        <span>90'</span>
                    </div>
                }
                else
                {
                    <div class="empty-events">
                        Gol zamanlaması bulunmuyor.
                    </div>
                }

            </section>


            <!-- ÖNE ÇIKAN OYUNCULAR -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">👤</span>
                        Maçta Öne Çıkan Oyuncular
                    </div>

                    <span class="panel-badge">
                        @uniquePlayers.Count OYUNCU
                    </span>

                </div>

                @if (uniquePlayers.Any())
                {
                    @foreach (var player in uniquePlayers)
                    {
                        var playerGoals = goals.Count(x =>
                        string.Equals(x.PlayerName, player, StringComparison.OrdinalIgnoreCase));

                        var playerCards = cards.Count(x =>
                        string.Equals(x.PlayerName, player, StringComparison.OrdinalIgnoreCase));

                        var playerSubsIn = substitutions.Count(x =>
                        string.Equals(x.PlayerIn, player, StringComparison.OrdinalIgnoreCase));

                        var playerSubsOut = substitutions.Count(x =>
                        string.Equals(x.PlayerOut, player, StringComparison.OrdinalIgnoreCase));

                        var playerTeam =
                        goals.FirstOrDefault(x =>
                        string.Equals(x.PlayerName, player, StringComparison.OrdinalIgnoreCase))?.Team
                        ??
                        cards.FirstOrDefault(x =>
                        string.Equals(x.PlayerName, player, StringComparison.OrdinalIgnoreCase))?.Team
                        ??
                        substitutions.FirstOrDefault(x =>
                        string.Equals(x.PlayerIn, player, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(x.PlayerOut, player, StringComparison.OrdinalIgnoreCase))?.Team
                        ??
                        "";

                        <div class="player-row">

                            <div class="player-number">
                                ⚽
                            </div>

                            <div style="flex:1;">

                                <div class="player-name">
                                    @player
                                </div>

                                <div class="player-team">
                                    @playerTeam
                                </div>

                            </div>

                            @if (playerGoals > 0)
                            {
                                <div class="player-event">
                                    ⚽ @playerGoals
                                </div>
                            }

                            @if (playerCards > 0)
                            {
                                <div class="player-event">
                                    🟨 @playerCards
                                </div>
                            }

                            @if (playerSubsIn > 0 || playerSubsOut > 0)
                            {
                                <div class="player-event">
                                    🔄
                                </div>
                            }

                        </div>
                    }
                }
                else
                {
                    <div class="empty-events">
                        Oyuncu olayı bulunmuyor.
                    </div>
                }

            </section>

        </main>


        <!-- RIGHT SIDEBAR -->
        <aside>


            <!-- RESULT -->
            <section class="panel">

                <div class="result-card">

                    <div class="result-label">
                        Maç Sonucu
                    </div>

                    <div class="result-title">
                        @resultText
                    </div>

                    <div class="result-score">
                        @homeScore - @awayScore
                    </div>

                </div>

            </section>


            <!-- TEAM ANALYSIS -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">🛡️</span>
                        Takım Analizi
                    </div>

                </div>


                <!-- HOME TEAM -->
                <div class="team-card">

                    <div class="team-card-head">

                        <img class="small-logo"
                             src="@Model.HomeTeamLogoUrl"
                             alt="@Model.HomeTeam"
                             onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(homeInitial)&background=075c3d&color=fff&bold=true&size=256';" />

                        <div>
                            <div class="team-card-name">
                                @Model.HomeTeam
                            </div>

                            <div class="team-card-sub">
                                Ev Sahibi
                            </div>
                        </div>

                    </div>

                    <div class="team-stats">

                        <div class="team-stat">
                            <div class="team-stat-value">
                                @homeGoals
                            </div>
                            <div class="team-stat-label">
                                Gol
                            </div>
                        </div>

                        <div class="team-stat">
                            <div class="team-stat-value">
                                @(homeYellowCards + homeRedCards)
                            </div>
                            <div class="team-stat-label">
                                Kart
                            </div>
                        </div>

                        <div class="team-stat">
                            <div class="team-stat-value">
                                @homeSubs
                            </div>
                            <div class="team-stat-label">
                                Değişiklik
                            </div>
                        </div>

                    </div>

                </div>


                <!-- AWAY TEAM -->
                <div class="team-card">

                    <div class="team-card-head">

                        <img class="small-logo"
                             src="@Model.AwayTeamLogoUrl"
                             alt="@Model.AwayTeam"
                             onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(awayInitial)&background=075c3d&color=fff&bold=true&size=256';" />

                        <div>
                            <div class="team-card-name">
                                @Model.AwayTeam
                            </div>

                            <div class="team-card-sub">
                                Deplasman
                            </div>
                        </div>

                    </div>

                    <div class="team-stats">

                        <div class="team-stat">
                            <div class="team-stat-value">
                                @awayGoals
                            </div>
                            <div class="team-stat-label">
                                Gol
                            </div>
                        </div>

                        <div class="team-stat">
                            <div class="team-stat-value">
                                @(awayYellowCards + awayRedCards)
                            </div>
                            <div class="team-stat-label">
                                Kart
                            </div>
                        </div>

                        <div class="team-stat">
                            <div class="team-stat-value">
                                @awaySubs
                            </div>
                            <div class="team-stat-label">
                                Değişiklik
                            </div>
                        </div>

                    </div>

                </div>

            </section>


            <!-- MATCH HIGHLIGHTS -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">🔥</span>
                        Maçın Öne Çıkanları
                    </div>

                </div>

                <div class="highlight-grid">

                    <div class="highlight">

                        <div class="highlight-icon">
                            ⚽
                        </div>

                        <div class="highlight-value">
                            @(firstGoal != null ? firstGoal.Minute + "'" : "-")
                        </div>

                        <div class="highlight-label">
                            İlk Gol
                        </div>

                    </div>


                    <div class="highlight">

                        <div class="highlight-icon">
                            🎯
                        </div>

                        <div class="highlight-value">
                            @(lastGoal != null ? lastGoal.Minute + "'" : "-")
                        </div>

                        <div class="highlight-label">
                            Son Gol
                        </div>

                    </div>


                    <div class="highlight">

                        <div class="highlight-icon">
                            🟨
                        </div>

                        <div class="highlight-value">
                            @totalCards
                        </div>

                        <div class="highlight-label">
                            Kart
                        </div>

                    </div>


                    <div class="highlight">

                        <div class="highlight-icon">
                            🔄
                        </div>

                        <div class="highlight-value">
                            @totalSubs
                        </div>

                        <div class="highlight-label">
                            Değişiklik
                        </div>

                    </div>

                </div>

            </section>


            <!-- EVENT DISTRIBUTION -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">📈</span>
                        Olay Dağılımı
                    </div>

                </div>


                <div class="stat-row">

                    <div class="stat-label">
                        <span>@Model.HomeTeam</span>
                        <span>@homeEvents olay</span>
                    </div>

                    <div class="bar-wrap">

                        <div class="bar-home"
                             style="width:@homeEventPercentage%">
                        </div>

                        <div class="bar-away"
                             style="width:@awayEventPercentage%">
                        </div>

                    </div>

                    <div class="stat-label" style="margin-top:5px;">
                        <span>@homeEventPercentage%</span>
                        <span>@awayEventPercentage%</span>
                    </div>

                </div>


                <div style="
                    display:flex;
                    justify-content:space-between;
                    align-items:center;
                    margin-top:18px;
                    font-size:10px;
                    font-weight:800;
                    color:#718079;">

                    <span>
                        🟢 @Model.HomeTeam
                    </span>

                    <span>
                        @Model.AwayTeam 🟢
                    </span>

                </div>

            </section>


            <!-- MATCH INFO -->
            <section class="panel">

                <div class="panel-head">

                    <div class="panel-title">
                        <span class="panel-title-icon">ℹ️</span>
                        Maç Bilgileri
                    </div>

                </div>

                <div style="display:grid;gap:10px;">

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        padding:11px 12px;
                        border-radius:11px;
                        background:#f7faf8;">

                        <span style="font-size:11px;color:#718079;">
                            🏆 Organizasyon
                        </span>

                        <strong style="font-size:11px;">
                            Serie A
                        </strong>

                    </div>

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        padding:11px 12px;
                        border-radius:11px;
                        background:#f7faf8;">

                        <span style="font-size:11px;color:#718079;">
                            📅 Tarih
                        </span>

                        <strong style="font-size:11px;">
                            @dateText
                        </strong>

                    </div>

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        padding:11px 12px;
                        border-radius:11px;
                        background:#f7faf8;">

                        <span style="font-size:11px;color:#718079;">
                            🕐 Başlama
                        </span>

                        <strong style="font-size:11px;">
                            @Model.Time
                        </strong>

                    </div>

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        padding:11px 12px;
                        border-radius:11px;
                        background:#f7faf8;">

                        <span style="font-size:11px;color:#718079;">
                            🏟️ Stadyum
                        </span>

                        <strong style="
                            font-size:11px;
                            text-align:right;
                            max-width:180px;">
                            @Model.Stadium
                        </strong>

                    </div>

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        padding:11px 12px;
                        border-radius:11px;
                        background:#f7faf8;">

                        <span style="font-size:11px;color:#718079;">
                            📌 Hafta
                        </span>

                        <strong style="font-size:11px;">
                            @Model.Week
                        </strong>

                    </div>

                </div>

            </section>


        </aside>

    </div>


    <!-- FOOTER -->
    <footer class="match-footer">

        <div>
            <span class="footer-brand">SERIE A MATCH CENTER</span>
            &nbsp; • &nbsp;
            Maç istatistikleri ve olay merkezi
        </div>

        <div>
            @Model.HomeTeam
            <strong>@homeScore</strong>
            -
            <strong>@awayScore</strong>
            @Model.AwayTeam
        </div>

    </footer>

</div>


<script>

    // Üst taraftaki saat
    function updateMatchClock() {

        const now = new Date();

        const hours = String(now.getHours()).padStart(2, "0");
        const minutes = String(now.getMinutes()).padStart(2, "0");

        const element = document.getElementById("matchClock");

        if (element) {
            element.innerHTML = "🕐 " + hours + ":" + minutes;
        }
    }

    updateMatchClock();

    setInterval(updateMatchClock, 30000);


    // Kartlara giriş animasyonu
    document.addEventListener("DOMContentLoaded", function () {

        const items = document.querySelectorAll(
            ".event, .kpi, .team-card, .highlight, .panel"
        );

        items.forEach(function (item, index) {

            item.style.opacity = "0";
            item.style.transform = "translateY(10px)";

            setTimeout(function () {

                item.style.transition =
                    "opacity .45s ease, transform .45s ease";

                item.style.opacity = "1";
                item.style.transform = "translateY(0)";

            }, Math.min(index * 35, 600));

        });

    });

</script>