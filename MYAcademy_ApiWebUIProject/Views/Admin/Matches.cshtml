```cshtml
@model MYAcademy_ApiWebUIProject.Controllers.AdminMatchesPageViewModel

@{
    ViewData["Title"] = "Maç Yönetimi";
    var matches = Model.Matches ?? new();
    var teams = Model.Teams ?? new();
}

<style>
    :root {
        --admin-navy: #14213d;
        --admin-navy-light: #203457;
        --admin-blue: #3767e8;
        --admin-bg: #f4f6fb;
        --admin-border: #e5e9f2;
        --admin-muted: #778198;
        --admin-text: #1d2939;
    }

    .admin-page {
        display: flex;
        min-height: calc(100vh - 60px);
        margin: -1.5rem;
        background: var(--admin-bg);
        color: var(--admin-text);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    .admin-sidebar {
        width: 245px;
        flex-shrink: 0;
        padding: 25px 15px;
        background: var(--admin-navy);
        color: white;
    }

    .admin-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 12px 28px;
        border-bottom: 1px solid #ffffff1a;
        font-size: 19px;
        font-weight: 800;
    }

    .admin-brand-icon {
        display: grid;
        place-items: center;
        width: 39px;
        height: 39px;
        border-radius: 12px;
        background: var(--admin-blue);
        font-size: 21px;
    }

    .admin-nav-label {
        padding: 25px 12px 10px;
        color: #9baac5;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .admin-nav {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: 9px;
            color: #c7d1e4;
            text-decoration: none;
            font-size: 14px;
            transition: background .2s, color .2s;
        }

            .admin-nav a:hover,
            .admin-nav a.active {
                background: #ffffff15;
                color: white;
            }

            .admin-nav a.active {
                box-shadow: inset 3px 0 var(--admin-blue);
            }

    .admin-main {
        min-width: 0;
        flex: 1;
        padding: 30px;
    }

    .admin-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 28px;
    }

        .admin-topbar h1 {
            margin: 0;
            color: var(--admin-text);
            font-size: clamp(24px, 3vw, 30px);
            font-weight: 800;
        }

        .admin-topbar p {
            margin: 7px 0 0;
            color: var(--admin-muted);
            font-size: 13px;
        }

    .admin-top-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .admin-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 10px 15px;
        border: 1px solid transparent;
        border-radius: 9px;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: .2s;
    }

    .admin-btn-primary {
        background: var(--admin-blue);
        color: white;
    }

        .admin-btn-primary:hover {
            background: #2853ce;
            color: white;
        }

    .admin-btn-light {
        border-color: var(--admin-border);
        background: white;
        color: var(--admin-text);
    }

        .admin-btn-light:hover {
            background: #f6f8fc;
        }

    .admin-btn-danger {
        background: #fff0f0;
        color: #c92b3a;
    }

    .admin-alert {
        margin-bottom: 18px;
        padding: 13px 16px;
        border: 1px solid;
        border-radius: 10px;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .admin-alert-success {
        border-color: #b6ebd1;
        background: #edfbf4;
        color: #157347;
    }

    .admin-alert-error {
        border-color: #f2c4c8;
        background: #fff1f2;
        color: #b42332;
    }

    .admin-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .admin-summary-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border: 1px solid var(--admin-border);
        border-radius: 13px;
        background: white;
    }

    .admin-summary-icon {
        display: grid;
        place-items: center;
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #eaf0ff;
        color: var(--admin-blue);
        font-size: 21px;
    }

    .admin-summary-card span {
        display: block;
        color: var(--admin-muted);
        font-size: 12px;
    }

    .admin-summary-card strong {
        display: block;
        margin-top: 5px;
        font-size: 25px;
    }

    .admin-card {
        overflow: hidden;
        border: 1px solid var(--admin-border);
        border-radius: 13px;
        background: white;
        box-shadow: 0 3px 12px #17294b05;
    }

    .admin-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 21px 22px;
        border-bottom: 1px solid var(--admin-border);
    }

        .admin-card-header h2 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
        }

        .admin-card-header p {
            margin: 6px 0 0;
            color: var(--admin-muted);
            font-size: 12px;
        }

    .admin-filter-form {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto auto;
        align-items: end;
        gap: 12px;
        padding: 20px 22px;
        border-bottom: 1px solid var(--admin-border);
    }

    .admin-field label {
        display: block;
        margin-bottom: 7px;
        color: #475467;
        font-size: 12px;
        font-weight: 700;
    }

    .admin-input,
    .admin-select {
        width: 100%;
        min-height: 41px;
        padding: 9px 11px;
        border: 1px solid #d9dfeb;
        border-radius: 8px;
        background: white;
        color: var(--admin-text);
        font: inherit;
        font-size: 13px;
    }

        .admin-input:focus,
        .admin-select:focus {
            border-color: var(--admin-blue);
            outline: 3px solid #3767e81c;
        }

    .admin-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        min-width: 880px;
        border-collapse: collapse;
    }

        .admin-table th {
            padding: 14px 16px;
            background: #f9faff;
            color: #7a8498;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .6px;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .admin-table td {
            padding: 15px 16px;
            border-top: 1px solid #edf0f6;
            color: #344054;
            font-size: 12px;
            white-space: nowrap;
        }

        .admin-table tbody tr:hover {
            background: #fafbff;
        }

    .admin-week {
        color: var(--admin-blue);
        font-weight: 800;
    }

    .admin-team {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
    }

    .admin-team-logo {
        display: grid;
        place-items: center;
        width: 27px;
        height: 27px;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 50%;
        background: #f1f4fa;
        color: #52617a;
        font-size: 9px;
        font-weight: 800;
    }

        .admin-team-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .admin-score {
        display: inline-block;
        min-width: 54px;
        padding: 7px 9px;
        border-radius: 7px;
        background: #eef2f8;
        color: #25344f;
        font-size: 12px;
        font-weight: 900;
        text-align: center;
    }

    .admin-score-empty {
        color: #98a2b3;
        font-weight: 500;
    }

    .admin-status {
        display: inline-block;
        padding: 6px 9px;
        border-radius: 999px;
        background: #f1f3f8;
        color: #667085;
        font-size: 10px;
        font-weight: 800;
    }

    .admin-status-done {
        background: #e8f8ef;
        color: #16804a;
    }

    .admin-status-live {
        background: #ffeded;
        color: #c92b3a;
    }

    .admin-row-actions {
        display: flex;
        gap: 6px;
    }

    .admin-icon-btn {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border: 1px solid var(--admin-border);
        border-radius: 7px;
        background: white;
        color: #53627a;
        cursor: pointer;
        font-size: 15px;
    }

        .admin-icon-btn:hover {
            border-color: #b8c8f8;
            color: var(--admin-blue);
        }

        .admin-icon-btn.delete:hover {
            border-color: #f2c4c8;
            background: #fff1f2;
            color: #c92b3a;
        }

    .admin-table-empty {
        padding: 45px 20px !important;
        color: var(--admin-muted) !important;
        text-align: center;
    }

        .admin-table-empty strong {
            display: block;
            margin-bottom: 7px;
            color: #344054;
            font-size: 15px;
        }

    .admin-card-footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 15px 22px;
        border-top: 1px solid var(--admin-border);
        color: var(--admin-muted);
        font-size: 12px;
    }

    .admin-modal {
        width: min(650px, calc(100% - 24px));
        max-height: 90vh;
        padding: 0;
        border: 0;
        border-radius: 16px;
        background: white;
        color: var(--admin-text);
        box-shadow: 0 25px 80px #0c183540;
    }

        .admin-modal::backdrop {
            background: #101a2d91;
            backdrop-filter: blur(3px);
        }

    .admin-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 21px 24px;
        border-bottom: 1px solid var(--admin-border);
    }

        .admin-modal-header h2 {
            margin: 0;
            font-size: 19px;
        }

    .admin-modal-body {
        max-height: calc(90vh - 145px);
        overflow-y: auto;
        padding: 22px 24px;
    }

    .admin-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 17px;
    }

        .admin-form-grid .full {
            grid-column: 1 / -1;
        }

    .admin-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 17px 24px;
        border-top: 1px solid var(--admin-border);
        background: #fbfcff;
    }

    .admin-form-error {
        display: none;
        margin-top: 6px;
        color: #c92b3a;
        font-size: 11px;
    }

    .admin-field.has-error .admin-input,
    .admin-field.has-error .admin-select {
        border-color: #d92d20;
    }

    .admin-field.has-error .admin-form-error {
        display: block;
    }

    .admin-form-alert {
        display: none;
        margin-bottom: 17px;
        padding: 12px;
        border-radius: 8px;
        background: #fff1f2;
        color: #b42332;
        font-size: 12px;
    }

        .admin-form-alert.show {
            display: block;
        }

    .admin-toast-area {
        position: fixed;
        z-index: 9999;
        top: 20px;
        right: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .admin-toast {
        max-width: 360px;
        padding: 14px 18px;
        border-radius: 10px;
        background: #14213d;
        color: white;
        box-shadow: 0 8px 25px #14213d25;
        font-size: 13px;
    }

    @@media (max-width: 1100px) {
        .admin-sidebar {
            width: 205px;
        }

        .admin-main {
            padding: 22px 16px;
        }

        .admin-filter-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .admin-page {
            flex-direction: column;
        }

        .admin-sidebar {
            width: 100%;
            padding: 15px;
        }

        .admin-brand {
            padding-bottom: 15px;
        }

        .admin-nav-label {
            padding-top: 15px;
        }

        .admin-nav {
            flex-direction: row;
            flex-wrap: wrap;
        }

            .admin-nav a {
                padding: 10px;
            }

        .admin-main {
            padding: 20px 12px;
        }

        .admin-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-summary {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .admin-filter-form {
            grid-template-columns: 1fr;
        }

        .admin-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-form-grid {
            grid-template-columns: 1fr;
        }

            .admin-form-grid .full {
                grid-column: auto;
            }

        .admin-card-footer {
            flex-direction: column;
        }
    }
</style>

<div class="admin-page">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <div class="admin-brand-icon">⚽</div>
            <span>Serie A Yönetim</span>
        </div>

        <div class="admin-nav-label">Yönetim</div>
        <nav class="admin-nav">
            <a asp-controller="Home" asp-action="Index">⌂ <span>Ana Sayfa</span></a>
            <a class="active" asp-controller="Admin" asp-action="Matches">▤ <span>Maç Yönetimi</span></a>
            <a asp-controller="Fixtures" asp-action="Index">▦ <span>Fikstür</span></a>
            <a asp-controller="Standings" asp-action="Index">▥ <span>Puan Durumu</span></a>
            <a asp-controller="Teams" asp-action="Details" asp-route-id="1">♧ <span>Takım Detayı</span></a>
        </nav>

        <div class="admin-nav-label">Siteye dön</div>
        <nav class="admin-nav">
            <a asp-controller="Fixtures" asp-action="Index">↗ <span>Siteyi Görüntüle</span></a>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <div>
                <h1>Maç Yönetimi</h1>
                <p>Serie A maçlarını listeleyin, ekleyin, düzenleyin ve yönetin.</p>
            </div>

            <div class="admin-top-actions">
                <button type="button" class="admin-btn admin-btn-primary" id="openCreate">
                    ＋ Yeni Maç Ekle
                </button>
            </div>
        </header>

        @if (TempData["AdminSuccess"] != null)
        {
            <div class="admin-alert admin-alert-success" role="status">
                @TempData["AdminSuccess"]
            </div>
        }

        @if (TempData["AdminError"] != null)
        {
            <div class="admin-alert admin-alert-error" role="alert">
                @TempData["AdminError"]
            </div>
        }

        <section class="admin-summary">
            <article class="admin-summary-card">
                <div class="admin-summary-icon">▤</div>
                <div>
                    <span>Toplam maç</span>
                    <strong>@matches.Count</strong>
                </div>
            </article>

            <article class="admin-summary-card">
                <div class="admin-summary-icon">✓</div>
                <div>
                    <span>Tamamlanan maç</span>
                    <strong>@matches.Count(m => IsFinished(m.Status))</strong>
                </div>
            </article>

            <article class="admin-summary-card">
                <div class="admin-summary-icon">◷</div>
                <div>
                    <span>Oynanacak maç</span>
                    <strong>@matches.Count(m => !IsFinished(m.Status) && !IsLive(m.Status))</strong>
                </div>
            </article>
        </section>

        <section class="admin-card">
            <div class="admin-card-header">
                <div>
                    <h2>Maç Listesi</h2>
                    <p>Maç kayıtlarını filtreleyin ve işlemleri yönetin.</p>
                </div>
            </div>

            <form class="admin-filter-form" id="filterForm">
                <div class="admin-field">
                    <label for="searchTeam">Takım ara</label>
                    <input class="admin-input" id="searchTeam" type="search" placeholder="Takım adı yazın..." />
                </div>

                <div class="admin-field">
                    <label for="filterWeek">Hafta</label>
                    <select class="admin-select" id="filterWeek">
                        <option value="">Tüm haftalar</option>
                        @foreach (var week in matches.Select(m => m.Week).Distinct().OrderBy(x => x))
                        {
                            <option value="@week">@week. Hafta</option>
                        }
                    </select>
                </div>

                <div class="admin-field">
                    <label for="filterStatus">Durum</label>
                    <select class="admin-select" id="filterStatus">
                        <option value="">Tüm durumlar</option>
                        @foreach (var status in matches.Select(m => m.Status).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <button type="submit" class="admin-btn admin-btn-primary">Filtrele</button>
                <button type="button" class="admin-btn admin-btn-light" id="resetFilters">Temizle</button>
            </form>

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Hafta</th>
                            <th>Tarih</th>
                            <th>Saat</th>
                            <th>Ev sahibi</th>
                            <th>Skor</th>
                            <th>Deplasman</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody id="matchRows">
                        @if (!matches.Any())
                        {
                            <tr>
                                <td colspan="9" class="admin-table-empty">
                                    <strong>Maç bulunamadı</strong>
                                    API'de henüz maç kaydı yok.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var match in matches.OrderBy(m => m.Week).ThenBy(m => m.MatchDate))
                            {
                                <tr data-match-row
                                    data-id="@match.MatchId"
                                    data-week="@match.Week"
                                    data-status="@match.Status"
                                    data-home="@match.HomeTeam?.Name"
                                    data-away="@match.AwayTeam?.Name">
                                    <td>@match.MatchId</td>
                                    <td><span class="admin-week">@match.Week. Hafta</span></td>
                                    <td>@match.MatchDate.ToString("dd.MM.yyyy")</td>
                                    <td>@match.Time</td>
                                    <td>
                                        <div class="admin-team">
                                            <span class="admin-team-logo">
                                                @if (!string.IsNullOrWhiteSpace(match.HomeTeam?.LogoUrl))
                                                {
                                                    <img src="@match.HomeTeam.LogoUrl" alt="" />
                                                }
                                                else
                                                {
                                                    @(match.HomeTeam?.Name?.Length > 0 ? match.HomeTeam.Name[..1] : "?")
                                                }
                                            </span>
                                            @(match.HomeTeam?.Name ?? "Bilinmiyor")
                                        </div>
                                    </td>
                                    <td>
                                        @if (match.HomeScore.HasValue && match.AwayScore.HasValue)
                                        {
                                            <span class="admin-score">@match.HomeScore - @match.AwayScore</span>
                                        }
                                        else
                                        {
                                            <span class="admin-score admin-score-empty">— : —</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="admin-team">
                                            <span class="admin-team-logo">
                                                @if (!string.IsNullOrWhiteSpace(match.AwayTeam?.LogoUrl))
                                                {
                                                    <img src="@match.AwayTeam.LogoUrl" alt="" />
                                                }
                                                else
                                                {
                                                    @(match.AwayTeam?.Name?.Length > 0 ? match.AwayTeam.Name[..1] : "?")
                                                }
                                            </span>
                                            @(match.AwayTeam?.Name ?? "Bilinmiyor")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="admin-status @StatusCss(match.Status)">
                                            @match.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="admin-row-actions">
                                            <button type="button"
                                                    class="admin-icon-btn"
                                                    title="Düzenle"
                                                    data-edit
                                                    data-id="@match.MatchId"
                                                    data-week="@match.Week"
                                                    data-home="@match.HomeTeamId"
                                                    data-away="@match.AwayTeamId"
                                                    data-date="@match.MatchDate.ToString("yyyy-MM-dd")"
                                                    data-time="@match.Time"
                                                    data-stadium="@match.Stadium"
                                                    data-status="@match.Status"
                                                    data-home-score="@match.HomeScore"
                                                    data-away-score="@match.AwayScore">
                                                ✎
                                            </button>

                                            <form asp-controller="Admin"
                                                  asp-action="DeleteMatch"
                                                  asp-route-id="@match.MatchId"
                                                  method="post"
                                                  onsubmit="return confirm('Bu maçı silmek istediğine emin misin?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="admin-icon-btn delete" title="Sil">⌫</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <footer class="admin-card-footer">
                <span id="matchCount">@matches.Count maç listeleniyor</span>
                <span>Veriler mevcut Serie A API'sinden yüklenir.</span>
            </footer>
        </section>
    </main>
</div>

<dialog class="admin-modal" id="matchModal">
    <form id="matchForm" method="post">
        @Html.AntiForgeryToken()

        <header class="admin-modal-header">
            <h2 id="modalTitle">Yeni Maç Ekle</h2>
            <button type="button" class="admin-icon-btn" id="closeModal" aria-label="Kapat">✕</button>
        </header>

        <div class="admin-modal-body">
            <div class="admin-form-alert" id="formAlert">
                Lütfen işaretlenen alanları kontrol edin.
            </div>

            <input type="hidden" name="MatchId" id="matchId" value="0" />

            <div class="admin-form-grid">
                <div class="admin-field" data-field="Week">
                    <label for="matchWeek">Hafta *</label>
                    <select class="admin-select" id="matchWeek" name="Week" required>
                        <option value="">Hafta seçin</option>
                        @for (int i = 1; i <= 38; i++)
                        {
                            <option value="@i">@i. Hafta</option>
                        }
                    </select>
                    <div class="admin-form-error">Hafta seçin.</div>
                </div>

                <div class="admin-field" data-field="MatchDate">
                    <label for="matchDate">Maç tarihi *</label>
                    <input class="admin-input" type="date" id="matchDate" name="MatchDate" required />
                    <div class="admin-form-error">Geçerli tarih girin.</div>
                </div>

                <div class="admin-field" data-field="Time">
                    <label for="matchTime">Saat *</label>
                    <input class="admin-input" type="time" id="matchTime" name="Time" required />
                    <div class="admin-form-error">Saat girin.</div>
                </div>

                <div class="admin-field" data-field="Status">
                    <label for="matchStatus">Maç durumu *</label>
                    <select class="admin-select" id="matchStatus" name="Status" required>
                        <option value="Başlamadı">Başlamadı</option>
                        <option value="Canlı">Canlı</option>
                        <option value="Tamamlandı">Tamamlandı</option>
                        <option value="Ertelendi">Ertelendi</option>
                    </select>
                </div>

                <div class="admin-field" data-field="HomeTeamId">
                    <label for="homeTeam">Ev sahibi *</label>
                    <select class="admin-select" id="homeTeam" name="HomeTeamId" required>
                        <option value="">Takım seçin</option>
                        @foreach (var team in teams.OrderBy(t => t.Name))
                        {
                            <option value="@team.TeamId" data-stadium="@team.Stadium">@team.Name</option>
                        }
                    </select>
                    <div class="admin-form-error">Ev sahibi takım seçin.</div>
                </div>

                <div class="admin-field" data-field="AwayTeamId">
                    <label for="awayTeam">Deplasman *</label>
                    <select class="admin-select" id="awayTeam" name="AwayTeamId" required>
                        <option value="">Takım seçin</option>
                        @foreach (var team in teams.OrderBy(t => t.Name))
                        {
                            <option value="@team.TeamId">@team.Name</option>
                        }
                    </select>
                    <div class="admin-form-error">Farklı bir deplasman takımı seçin.</div>
                </div>

                <div class="admin-field full">
                    <label for="matchStadium">Stadyum</label>
                    <input class="admin-input" type="text" id="matchStadium" name="Stadium" maxlength="150" placeholder="Stadyum adı" />
                </div>

                <div class="admin-field" data-field="HomeScore" id="homeScoreField">
                    <label for="homeScore">Ev sahibi skoru</label>
                    <input class="admin-input" type="number" id="homeScore" name="HomeScore" min="0" max="99" />
                    <div class="admin-form-error">0 veya daha büyük bir skor girin.</div>
                </div>

                <div class="admin-field" data-field="AwayScore" id="awayScoreField">
                    <label for="awayScore">Deplasman skoru</label>
                    <input class="admin-input" type="number" id="awayScore" name="AwayScore" min="0" max="99" />
                    <div class="admin-form-error">0 veya daha büyük bir skor girin.</div>
                </div>
            </div>
        </div>

        <footer class="admin-modal-footer">
            <button type="button" class="admin-btn admin-btn-light" id="cancelModal">Vazgeç</button>
            <button type="submit" class="admin-btn admin-btn-primary" id="saveMatch">Maçı Kaydet</button>
        </footer>
    </form>
</dialog>

<div class="admin-toast-area" id="toastArea" aria-live="polite"></div>

@functions {
    public bool IsFinished(string? status) =>
        string.Equals(status, "Tamamlandı", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(status, "Finished", StringComparison.OrdinalIgnoreCase);

    public bool IsLive(string? status) =>
        string.Equals(status, "Canlı", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(status, "Live", StringComparison.OrdinalIgnoreCase);

    public string StatusCss(string? status)
    {
        if (IsFinished(status)) return "admin-status-done";
        if (IsLive(status)) return "admin-status-live";
        return "";
    }
}

<script>
    (() => {
        const modal = document.getElementById('matchModal');
        const form = document.getElementById('matchForm');
        const rows = [...document.querySelectorAll('[data-match-row]')];
        const search = document.getElementById('searchTeam');
        const weekFilter = document.getElementById('filterWeek');
        const statusFilter = document.getElementById('filterStatus');
        const count = document.getElementById('matchCount');

        const field = id => document.getElementById(id);

        function toast(message) {
            const node = document.createElement('div');
            node.className = 'admin-toast';
            node.textContent = message;
            document.getElementById('toastArea').appendChild(node);
            setTimeout(() => node.remove(), 3000);
        }

        function clearErrors() {
            document.querySelectorAll('.admin-field.has-error')
                .forEach(x => x.classList.remove('has-error'));
            field('formAlert').classList.remove('show');
        }

        function showModal() {
            if (!modal.open) modal.showModal();
        }

        function closeModal() {
            if (modal.open) modal.close();
        }

        function toggleScores() {
            const status = field('matchStatus').value;
            const show = status === 'Canlı' || status === 'Tamamlandı';

            field('homeScoreField').style.display = show ? '' : 'none';
            field('awayScoreField').style.display = show ? '' : 'none';

            if (!show) {
                field('homeScore').value = '';
                field('awayScore').value = '';
            }
        }

        function resetForm() {
            form.reset();
            clearErrors();
            field('matchId').value = '0';
            field('modalTitle').textContent = 'Yeni Maç Ekle';
            field('saveMatch').textContent = 'Maçı Kaydet';
            form.action = '@Url.Action("CreateMatch", "Admin")';
            toggleScores();
        }

        field('openCreate').addEventListener('click', () => {
            resetForm();
            showModal();
        });

        field('closeModal').addEventListener('click', closeModal);
        field('cancelModal').addEventListener('click', closeModal);
        field('matchStatus').addEventListener('change', toggleScores);

        field('homeTeam').addEventListener('change', () => {
            const option = field('homeTeam').selectedOptions[0];
            if (option && option.dataset.stadium && !field('matchStadium').value) {
                field('matchStadium').value = option.dataset.stadium;
            }
        });

        document.querySelectorAll('[data-edit]').forEach(button => {
            button.addEventListener('click', () => {
                resetForm();

                field('modalTitle').textContent = 'Maçı Düzenle';
                field('saveMatch').textContent = 'Değişiklikleri Kaydet';
                form.action = '@Url.Action("UpdateMatch", "Admin")';

                field('matchId').value = button.dataset.id;
                field('matchWeek').value = button.dataset.week;
                field('homeTeam').value = button.dataset.home;
                field('awayTeam').value = button.dataset.away;
                field('matchDate').value = button.dataset.date;
                field('matchTime').value = button.dataset.time;
                field('matchStadium').value = button.dataset.stadium || '';
                field('matchStatus').value = button.dataset.status;

                field('homeScore').value = button.dataset.homeScore || '';
                field('awayScore').value = button.dataset.awayScore || '';

                toggleScores();
                showModal();
            });
        });

        function filterRows() {
            const term = search.value.trim().toLocaleLowerCase('tr-TR');
            const week = weekFilter.value;
            const status = statusFilter.value;
            let visible = 0;

            rows.forEach(row => {
                const teams = `${row.dataset.home || ''} ${row.dataset.away || ''}`
                    .toLocaleLowerCase('tr-TR');

                const match =
                    (!term || teams.includes(term)) &&
                    (!week || row.dataset.week === week) &&
                    (!status || row.dataset.status === status);

                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });

            count.textContent = `${visible} maç gösteriliyor`;
        }

        document.getElementById('filterForm').addEventListener('submit', event => {
            event.preventDefault();
            filterRows();
        });

        search.addEventListener('input', filterRows);
        weekFilter.addEventListener('change', filterRows);
        statusFilter.addEventListener('change', filterRows);

        field('resetFilters').addEventListener('click', () => {
            search.value = '';
            weekFilter.value = '';
            statusFilter.value = '';
            filterRows();
        });

        form.addEventListener('submit', event => {
            clearErrors();

            const errors = [];
            const home = field('homeTeam').value;
            const away = field('awayTeam').value;
            const status = field('matchStatus').value;
            const completedOrLive = status === 'Canlı' || status === 'Tamamlandı';

            ['Week', 'MatchDate', 'Time', 'HomeTeamId', 'AwayTeamId'].forEach(name => {
                const input = form.elements[name];
                if (!input || !input.value) {
                    errors.push(name);
                    input?.closest('.admin-field')?.classList.add('has-error');
                }
            });

            if (home && away && home === away) {
                errors.push('AwayTeamId');
                field('awayTeam').closest('.admin-field').classList.add('has-error');
            }

            if (status === 'Tamamlandı' &&
                (field('homeScore').value === '' || field('awayScore').value === '')) {
                ['homeScore', 'awayScore'].forEach(id => {
                    if (field(id).value === '') {
                        errors.push(id);
                        field(id).closest('.admin-field').classList.add('has-error');
                    }
                });
            }

            if (completedOrLive) {
                ['homeScore', 'awayScore'].forEach(id => {
                    const input = field(id);
                    if (input.value !== '' && Number(input.value) < 0) {
                        errors.push(id);
                        input.closest('.admin-field').classList.add('has-error');
                    }
                });
            }

            if (errors.length) {
                event.preventDefault();
                field('formAlert').classList.add('show');
                toast('Formdaki hatalı alanları kontrol et.');
            }
        });

        modal.addEventListener('click', event => {
            if (event.target === modal) closeModal();
        });

        toggleScores();
        filterRows();
    })();
</script>
