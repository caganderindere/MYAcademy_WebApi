<main class="football-page">
    <div class="football-shell">

        <section class="hero">
            <div class="hero-main">
                <div class="brand">
                    <span class="brand-icon">⚽</span>
                    <span>İTALYA FUTBOL LİGİ · MAÇ VE İSTATİSTİK MERKEZİ</span>
                </div>

                <h1>Futbolun <span>istatistiklerle</span><br>buluştuğu yer.</h1>

                <p>
                    Serie A maçlarını takip et, takım performanslarını karşılaştır
                    ve haftanın oyuncu istatistiklerini tek ekranda incele.
                </p>
            </div>

            <div class="hero-side">
                <div class="hero-stat">
                    <strong>@matches.Count</strong>
                    <span>HAFTANIN MAÇI</span>
                </div>
                <div class="hero-stat">
                    <strong>@completed.Count</strong>
                    <span>TAMAMLANAN</span>
                </div>
                <div class="hero-stat">
                    <strong>@teams.Count</strong>
                    <span>SAHADAKİ TAKIM</span>
                </div>
                <div class="hero-stat">
                    <strong>@totalGoals</strong>
                    <span>ATILAN GOL</span>
                </div>
            </div>
        </section>

        <section class="stats-grid">
            <article class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Toplam gol</span>
                    <span class="stat-icon">⚽</span>
                </div>
                <strong class="stat-value">@totalGoals</strong>
                <div class="stat-note">Tamamlanan maçların skorları</div>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Tamamlanan maç</span>
                    <span class="stat-icon">✓</span>
                </div>
                <strong class="stat-value">@completed.Count</strong>
                <div class="stat-note">Toplam @matches.Count maç</div>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Bekleyen maç</span>
                    <span class="stat-icon">◷</span>
                </div>
                <strong class="stat-value">@pending</strong>
                <div class="stat-note">Henüz tamamlanmayan karşılaşmalar</div>
            </article>

            <article class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Maç başına gol</span>
                    <span class="stat-icon">↗</span>
                </div>
                <strong class="stat-value">@averageGoals.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                <div class="stat-note">Tamamlanan maçların ortalaması</div>
            </article>
        </section>

        <section class="section panel fixture-controls">
            <div class="section-heading">
                <div>
                    <div class="section-kicker">FİKSTÜR</div>
                    <h2 class="section-title">Haftalık maç programı</h2>
                    <p class="section-description">İstediğin haftayı seçerek maçları ve sonuçları görüntüle.</p>
                </div>
                <span class="pill">Seçili hafta: <strong>@selectedWeek</strong></span>
            </div>

            <div class="filter-row">
                <form asp-controller="Fixtures" asp-action="Index" method="get" class="week-form">
                    <input class="field week-input" type="number" name="week"
                           min="1" max="38" value="@selectedWeek"
                           aria-label="Hafta numarası" required>
                    <button type="submit" class="action-button">Haftaya git →</button>
                </form>
            </div>

            <nav class="week-list" aria-label="Fikstür haftaları">
                @for (var i = 1; i <= 38; i++)
                {
                    <a class="week-link @(selectedWeek == i ? "active" : "")"
                       asp-controller="Fixtures" asp-action="Index" asp-route-week="@i">
                        @i. hafta
                    </a>
                }
            </nav>
        </section>

        <section class="section">
            <div class="section-heading">
                <div>
                    <div class="section-kicker">HAFTALIK ANALİZ</div>
                    <h2 class="section-title">Sahanın istatistikleri</h2>
                    <p class="section-description">
                        Seçili haftanın tamamlanmış maçlarından hesaplanan iki temel grafik.
                    </p>
                </div>
                <span class="pill">@selectedWeek. hafta verileri</span>
            </div>

            <div class="chart-grid">
                <article class="chart-card">
                    <div class="chart-header">
                        <div>
                            <h3 class="chart-title">Takımların gol performansı</h3>
                            <p class="chart-subtitle">Atılan gollere göre ilk 10 takım</p>
                        </div>
                        <span class="chart-badge">GOL SAYISI</span>
                    </div>

                    <div class="chart-wrap">
                        @if (completed.Any())
                        {
                            <canvas id="teamGoalsChart" aria-label="Takımların gol performansı"></canvas>
                        }
                        else
                        {
                            <div class="empty-message">Grafiği oluşturmak için tamamlanmış maç bulunmuyor.</div>
                        }
                    </div>

                    <div class="chart-note">
                        Veriler seçili haftadaki maç skorlarından hesaplanır.
                    </div>
                </article>

                <article class="chart-card">
                    <div class="chart-header">
                        <div>
                            <h3 class="chart-title">Maç sonuçlarının dağılımı</h3>
                            <p class="chart-subtitle">Ev sahibi, beraberlik ve deplasman sonuçları</p>
                        </div>
                        <span class="chart-badge">SONUÇLAR</span>
                    </div>

                    <div class="chart-wrap">
                        @if (completed.Any())
                        {
                            <canvas id="outcomesChart" aria-label="Maç sonuçlarının dağılımı"></canvas>
                        }
                        else
                        {
                            <div class="empty-message">Sonuçlar girildiğinde grafik burada görüntülenir.</div>
                        }
                    </div>

                    <div class="chart-note">
                        Ev sahibi: @homeWins · Beraberlik: @draws · Deplasman: @awayWins
                    </div>
                </article>
            </div>
        </section>

        <section class="section">
            <div class="section-heading">
                <div>
                    <div class="section-kicker">OYUNCU İSTATİSTİKLERİ</div>
                    <h2 class="section-title">Haftanın yıldızları</h2>
                    <p class="section-description">
                        Gol ve kırmızı kart kayıtları maç detaylarındaki gerçek olaylardan toplanır.
                    </p>
                </div>
            </div>

            <div class="leaders-grid">
                <article class="leader-card">
                    <div class="leader-header">
                        <h3>⚽ Gol krallığı</h3>
                        <p>Seçili haftanın maçlarında atılan goller</p>
                    </div>
                    <div id="topScorers" class="leader-list">
                        <div class="empty-message">Gol kayıtları yükleniyor...</div>
                    </div>
                    <div class="leader-note">
                        Bu liste yalnızca seçili haftanın maçlarını kapsar; sezon geneli sıralama değildir.
                    </div>
                </article>

                <article class="leader-card">
                    <div class="leader-header">
                        <h3>🟥 Kırmızı kart raporu</h3>
                        <p>Kırmızı kart gören oyuncular</p>
                    </div>
                    <div id="redCardLeaders" class="leader-list">
                        <div class="empty-message">Kart kayıtları yükleniyor...</div>
                    </div>
                    <div class="leader-note">
                        Yalnızca kırmızı kart olarak kayıtlı olaylar sayılır; sarı kartlar dahil edilmez.
                    </div>
                </article>
            </div>
        </section>

        <section class="section">
            <div class="section-heading">
                <div>
                    <div class="section-kicker">MAÇ MERKEZİ</div>
                    <h2 class="section-title">@selectedWeek. hafta maçları</h2>
                    <p class="section-description">Takım adına göre ara veya maç durumuna göre filtrele.</p>
                </div>
                <span class="pill"><strong id="visibleCount">@matches.Count</strong> maç</span>
            </div>

            <div class="filter-row">
                <input id="matchSearch" class="field search-input" type="search"
                       placeholder="🔎 Takım ara..." aria-label="Takım adına göre ara">

                <select id="matchStatus" class="field" aria-label="Maç durumunu seç">
                    <option value="all">Tüm maçlar</option>
                    <option value="done">Tamamlanan maçlar</option>
                    <option value="pending">Bekleyen maçlar</option>
                </select>
            </div>

            @if (matches.Any())
            {
                <div class="match-grid" id="matchGrid">
                    @foreach (var match in matches.OrderBy(m => m.MatchDate).ThenBy(m => m.Time))
                    {
                        var hasScore = match.HomeScore.HasValue && match.AwayScore.HasValue;
                        var home = match.HomeTeam?.Name ?? "Ev sahibi";
                        var away = match.AwayTeam?.Name ?? "Deplasman";
                        var status = match.Status ?? "";

                        var finished = hasScore
                        || status.Contains("Tamamlandı", StringComparison.OrdinalIgnoreCase)
                        || status.Contains("Bitti", StringComparison.OrdinalIgnoreCase);

                        var searchText = $"{home} {away} {match.Stadium} {status}".ToLowerInvariant();

                        <article class="match-card"
                                 data-search="@searchText"
                                 data-status="@(finished ? "done" : "pending")">

                            <div class="match-meta">
                                <span>@match.MatchDate.ToString("dd.MM.yyyy") @(string.IsNullOrWhiteSpace(match.Time) ? "" : " · " + match.Time)</span>
                                <span class="match-status @(finished ? "finished" : "")">
                                    @(finished ? "TAMAMLANDI" : "PROGRAMDA")
                                </span>
                            </div>

                            <div class="match-teams">
                                <div class="team">
                                    <span class="team-badge">@(home.Length > 0 ? home.Substring(0, 1).ToUpperInvariant() : "E")</span>
                                    <div>
                                        <div class="team-name">@home</div>
                                        <div class="team-role">EV SAHİBİ</div>
                                    </div>
                                </div>

                                <div class="score @(hasScore ? "" : "pending")">
                                    @if (hasScore)
                                    {
                                        @match.HomeScore
                                        <span> - </span>

                                        @match.AwayScore
                                    }
                                    else
                                    {
                                        <span>VS</span>
                                    }
                                </div>

                                <div class="team away">
                                    <span class="team-badge">@(away.Length > 0 ? away.Substring(0, 1).ToUpperInvariant() : "D")</span>
                                    <div>
                                        <div class="team-name">@away</div>
                                        <div class="team-role">DEPLASMAN</div>
                                    </div>
                                </div>
                            </div>

                            <div class="match-footer">
                                <span class="stadium">
                                    ⌖ @(string.IsNullOrWhiteSpace(match.Stadium) ? "Stadyum belirtilmedi" : match.Stadium)
                                </span>
                                <a class="detail-link"
                                   asp-controller="Match"
                                   asp-action="Detail"
                                   asp-route-id="@match.MatchId">
                                    Maç detayları ↗
                                </a>
                            </div>
                        </article>
                    }
                </div>

                <div id="noMatchResults" class="panel empty-message" hidden>
                    Bu filtreye uygun maç bulunamadı.
                </div>
            }
            else
            {
                <div class="panel empty-message">
                    Bu hafta için maç bulunamadı. Başka bir hafta seçmeyi dene.
                </div>
            }
        </section>

        <footer class="page-footer">
            <strong>SERIE A · FUTBOL MERKEZİ</strong>
            <span>Maçlar, skorlar ve istatistikler tek yerde.</span>
        </footer>

    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", async function () {
        // Maç arama ve durum filtreleme
        const searchInput = document.getElementById("matchSearch");
        const statusSelect = document.getElementById("matchStatus");
        const matchCards = Array.from(document.querySelectorAll(".match-card"));
        const visibleCount = document.getElementById("visibleCount");
        const noResults = document.getElementById("noMatchResults");

        function applyFilters() {
            const query = (searchInput?.value || "").trim().toLocaleLowerCase("tr-TR");
            const selectedStatus = statusSelect?.value || "all";
            let visible = 0;

            matchCards.forEach(card => {
                const text = (card.dataset.search || "").toLocaleLowerCase("tr-TR");
                const nameMatches = !query || text.includes(query);
                const statusMatches =
                    selectedStatus === "all" || card.dataset.status === selectedStatus;

                const show = nameMatches && statusMatches;
                card.hidden = !show;

                if (show) visible++;
            });

            if (visibleCount) visibleCount.textContent = visible;
            if (noResults) noResults.hidden = visible !== 0;
        }

        searchInput?.addEventListener("input", applyFilters);
        statusSelect?.addEventListener("change", applyFilters);

        // İki grafik
        if (typeof Chart !== "undefined") {
            Chart.defaults.color = "#8fa2bf";
            Chart.defaults.font.family = "Inter, sans-serif";

            const tooltipOptions = {
                backgroundColor: "#17243a",
                titleColor: "#ffffff",
                bodyColor: "#edf3fc",
                padding: 11,
                cornerRadius: 8
            };

            const teamLabels = @Html.Raw(JsonSerializer.Serialize(teamLabels));
            const teamGoalValues = @Html.Raw(JsonSerializer.Serialize(teamGoals));
            const outcomeLabels = @Html.Raw(JsonSerializer.Serialize(outcomeLabels));
            const outcomeValues = @Html.Raw(JsonSerializer.Serialize(outcomeValues));

            const teamCanvas = document.getElementById("teamGoalsChart");

            if (teamCanvas) {
                new Chart(teamCanvas, {
                    type: "bar",
                    data: {
                        labels: teamLabels,
                        datasets: [{
                            label: "Gol",
                            data: teamGoalValues,
                            backgroundColor: "#5794ff",
                            hoverBackgroundColor: "#45d5d1",
                            borderRadius: 6,
                            borderSkipped: false,
                            maxBarThickness: 25
                        }]
                    },
                    options: {
                        indexAxis: "y",
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: tooltipOptions
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                ticks: { precision: 0, stepSize: 1 },
                                grid: { color: "rgba(143,162,191,.12)" },
                                border: { display: false }
                            },
                            y: {
                                grid: { display: false },
                                border: { display: false }
                            }
                        }
                    }
                });
            }

            const outcomeCanvas = document.getElementById("outcomesChart");

            if (outcomeCanvas) {
                new Chart(outcomeCanvas, {
                    type: "doughnut",
                    data: {
                        labels: outcomeLabels,
                        datasets: [{
                            data: outcomeValues,
                            backgroundColor: ["#5794ff", "#45d5d1", "#a78bfa"],
                            borderColor: "#121c2e",
                            borderWidth: 4,
                            hoverOffset: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "67%",
                        plugins: {
                            legend: {
                                position: "bottom",
                                labels: {
                                    usePointStyle: true,
                                    pointStyle: "circle",
                                    padding: 16,
                                    boxWidth: 8,
                                    font: { size: 10 }
                                }
                            },
                            tooltip: tooltipOptions
                        }
                    }
                });
            }
        }

        // Oyuncu istatistikleri: seçili haftanın maç detaylarından toplanır.
        const matchIds = @Html.Raw(JsonSerializer.Serialize(matchIds));
        const scorers = new Map();
        const redCards = new Map();

        const scorerContainer = document.getElementById("topScorers");
        const redCardContainer = document.getElementById("redCardLeaders");

        function addStat(map, player, team) {
            const key = `${player}|||${team || ""}`;
            const current = map.get(key) || {
                player: player,
                team: team || "Takım belirtilmedi",
                count: 0
            };

            current.count++;
            map.set(key, current);
        }

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            }[character]));
        }

        function renderLeaders(container, map, type, emptyMessage) {
            if (!container) return;

            const leaders = Array.from(map.values())
                .sort((a, b) => b.count - a.count || a.player.localeCompare(b.player, "tr"))
                .slice(0, 5);

            if (!leaders.length) {
                container.innerHTML = `<div class="empty-message">${escapeHtml(emptyMessage)}</div>`;
                return;
            }

            container.innerHTML = leaders.map((player, index) => {
                const initial = (player.player || "?")
                    .trim()
                    .charAt(0)
                    .toLocaleUpperCase("tr-TR");

                return `
                    <div class="leader-row">
                        <span class="rank ${index === 0 ? "first" : ""}">${index + 1}</span>
                        <span class="player-avatar">${escapeHtml(initial)}</span>
                        <div class="player-info">
                            <div class="player-name">${escapeHtml(player.player)}</div>
                            <div class="player-team">${escapeHtml(player.team)}</div>
                        </div>
                        <strong class="player-value ${type === "card" ? "card" : ""}">
                            ${player.count}
                        </strong>
                    </div>`;
            }).join("");
        }

        if (matchIds.length) {
            const apiBase = "https://localhost:7009/api/Matches/";
            let apiFailed = false;

            await Promise.all(matchIds.map(async id => {
                try {
                    const response = await fetch(apiBase + encodeURIComponent(id));

                    if (!response.ok) {
                        apiFailed = true;
                        return;
                    }

                    const match = await response.json();

                    (match.goals || []).forEach(goal => {
                        if (goal.playerName) {
                            addStat(scorers, goal.playerName, goal.team);
                        }
                    });

                    (match.cards || []).forEach(card => {
                        const cardType = String(card.cardType || "")
                            .toLocaleLowerCase("tr-TR");

                        if (cardType.includes("kırmızı") && card.playerName) {
                            addStat(redCards, card.playerName, card.team);
                        }
                    });
                } catch (error) {
                    apiFailed = true;
                    console.warn("Oyuncu istatistikleri alınamadı:", id, error);
                }
            }));

            renderLeaders(
                scorerContainer,
                scorers,
                "goal",
                apiFailed
                    ? "Oyuncu verileri alınamadı. API adresini ve CORS ayarlarını kontrol et."
                    : "Bu haftanın maç detaylarında golcü kaydı bulunamadı."
            );

            renderLeaders(
                redCardContainer,
                redCards,
                "card",
                apiFailed
                    ? "Kart verileri alınamadı. API adresini ve CORS ayarlarını kontrol et."
                    : "Bu haftanın maç detaylarında kırmızı kart kaydı bulunamadı."
            );
        } else {
            renderLeaders(
                scorerContainer,
                scorers,
                "goal",
                "Gol krallığı için tamamlanmış maç bulunmuyor."
            );

            renderLeaders(
                redCardContainer,
                redCards,
                "card",
                "Kart raporu için tamamlanmış maç bulunmuyor."
            );
        }
    });
</script>
```